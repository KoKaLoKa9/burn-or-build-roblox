local MachineArtPalette = {}

function MachineArtPalette.Apply(model: Instance): number
	local painted = 0
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local swatch = Swatches[PartSwatch[descendant.Name] or ""]
			if swatch then
				descendant.Color = swatch.Color
				descendant.Material = swatch.Material
				painted += 1
			end
		end
	end
	return painted
end

return MachineArtPalette
