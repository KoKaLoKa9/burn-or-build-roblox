					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict

-- Plain data only (no Roblox types) so the Lune tests can require this file.
-- Kind: Source releases stored items, Processor runs a recipe, Sink sells items,
-- Storage buffers one straw type, Terminal has no ports and runs truck trips.
-- ExhaustOffset is the steam stack top on the imported model, from the base center in studs.
-- UnlockAfterFirstSale follows spec 12.2: storage and trucks unlock after the first pellet sale.
return {
	CollectionPoint = {
		DisplayName = "Straw collection point",
		Kind = "Source",
		Placeable = false,
		AcceptsItem = "WetStraw",
		OutputItem = "WetStraw",
		OutputCapacity = 8,
	},
	Dryer = {
		DisplayName = "Dryer",
		Kind = "Processor",
		Placeable = true,
		Cost = 200,
		InputItem = "WetStraw",
		OutputItem = "DryStraw",
		InputPerCycle = 1,
		OutputPerCycle = 1,
		CycleSeconds = 60 / 8,
		InputCapacity = 2,
		OutputCapacity = 2,
		Size = { X = 16, Y = 12, Z = 14 },
		ExhaustOffset = { X = 5.6, Y = 11.7, Z = -1.2 },
		Color = { 219, 157, 55 },
	},
	Shredder = {
		DisplayName = "Shredder",
		Kind = "Processor",
		Placeable = true,
		Cost = 250,
		InputItem = "DryStraw",
		OutputItem = "ShreddedStraw",
		InputPerCycle = 1,
		OutputPerCycle = 1,
		CycleSeconds = 60 / 10,
		InputCapacity = 2,
		OutputCapacity = 2,
		Size = { X = 16, Y = 10, Z = 14 },
		ExhaustOffset = { X = -4.4, Y = 8.9, Z = -4.6 },
		Color = { 58, 98, 93 },
	},
	PelletMill = {
		DisplayName = "Pellet mill",
		Kind = "Processor",
		Placeable = true,
		Cost = 350,
		InputItem = "ShreddedStraw",
		OutputItem = "PelletCrate",
		InputPerCycle = 2,
		OutputPerCycle = 1,
		CycleSeconds = 60 / 3,
		InputCapacity = 4,
		OutputCapacity = 1,
		OperatingCostPerCycle = 30,
		Size = { X = 18, Y = 14, Z = 16 },
		ExhaustOffset = { X = -2.4, Y = 12.2, Z = -5.2 },
		Color = { 43, 63, 59 },
	},
	CoveredStorage = {
		DisplayName = "Covered storage",
		Kind = "Storage",
		Placeable = true,
		UnlockAfterFirstSale = true,
		Cost = 250,
		Capacity = 12,
		StoresItems = { "WetStraw", "DryStraw", "ShreddedStraw" },
		Size = { X = 14, Y = 10, Z = 14 },
		Color = { 92, 120, 150 },
	},
	TruckTerminal = {
		DisplayName = "Truck route terminal",
		Kind = "Terminal",
		Placeable = true,
		UnlockAfterFirstSale = true,
		RequiresRoad = true,
		NoPorts = true,
		Cost = 500,
		Size = { X = 20, Y = 8, Z = 14 },
		Color = { 168, 92, 52 },
	},
	BuyerDepot = {
		DisplayName = "Buyer depot",
		Kind = "Sink",
		Placeable = false,
		AcceptsItem = "PelletCrate",
		SalePrice = 150,
	},
}
]]></ProtectedString>
					<string name="ScriptGuid">{FD3B6A27-16B5-464B-AE90-43A553CC935E}</string>
