						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">MachineService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">72fda515d654c1e30ae37d4100000b71</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0103C6A17C50461F8105DD18CC673E63">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- Neighboring farm commitments for Farm_B and Farm_C (spec v0.2 section 10).
-- The rules live in Simulation/FarmCommitments; this service owns prompts, billboards,
-- rewards, and burns. Missed or unserved farms burn through SmokeService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CommitmentDefinitions = require(Shared:WaitForChild("CommitmentDefinitions"))

local FarmBoard = require(script.Parent:WaitForChild("FarmBoard"))
local StrawSheaf = require(script.Parent:WaitForChild("StrawSheaf"))

local Simulation = script.Parent.Parent:WaitForChild("Simulation")
local FarmCommitments = require(Simulation:WaitForChild("FarmCommitments"))

local CommitmentService = {}

local UPDATE_SECONDS = 0.5

type FarmView = {
	model: Model,
	burnPoint: BasePart,
	board: Board,
	acceptPrompt: ProximityPrompt,
	rejectPrompt: ProximityPrompt,
	extendPrompt: ProximityPrompt,
	-- One standing sheaf per bundle still in the field, walked up to and picked up like Farm A.
	sheaves: { Model },
	charred: boolean,
	burnColor: Color3,
}

local book: any
local views: { [string]: FarmView } = {}
local world: Model
local playerState: any
local smokeService: any
local machineService: any
local gameConfig: any

local STATE_TEXT: { [string]: string } = {
	Available = "AVAILABLE",
	Accepted = "ACCEPTED",
	Rejected = "REJECTED",
	InProgress = "IN PROGRESS",
	Completed = "COMPLETED",
	Missed = "MISSED",
	Extended = "EXTENDED",
	Burned = "BURNED",
}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function asPlayer(owner: any): Player?
	if typeof(owner) == "Instance" and owner:IsA("Player") and owner.Parent ~= nil then
		return owner
	end
	return nil
end

local function formatClock(seconds: number): string
	local whole = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

local function createPrompt(
	parent: BasePart,
	name: string,
	actionText: string,
	objectText: string,
	key: Enum.KeyCode,
	holdDuration: number
): ProximityPrompt
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.KeyboardKeyCode = key
	prompt.HoldDuration = holdDuration
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

type Board = FarmBoard.Board

local MUTED = FarmBoard.Colors.Muted
local STATE_COLORS: { [string]: Color3 } = {
	Available = FarmBoard.Colors.Teal,
	Accepted = FarmBoard.Colors.Gold,
	InProgress = FarmBoard.Colors.Gold,
	Extended = FarmBoard.Colors.Gold,
	Completed = FarmBoard.Colors.Green,
	Rejected = MUTED,
	Missed = FarmBoard.Colors.Red,
	Burned = FarmBoard.Colors.Red,
}

local function sheafPrompts(view: FarmView, enabled: boolean)
	for _, sheaf in view.sheaves do
		local prompt = sheaf:FindFirstChild("PickUpPrompt", true)
		if prompt and prompt:IsA("ProximityPrompt") then
			prompt.Enabled = enabled
		end
	end
end

-- Keeps the standing sheaves equal to the straw left, whoever took it (player or truck).
local function syncSheaves(view: FarmView, remaining: number, burned: boolean)
	if burned then
		if not view.charred then
			view.charred = true
			for _, sheaf in view.sheaves do
				StrawSheaf.Char(sheaf)
			end
		end
		return
	end
	while #view.sheaves > remaining do
		local sheaf = table.remove(view.sheaves) :: Model
		sheaf:Destroy()
	end
end

local function setRiceVisible(model: Model, visible: boolean)
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") and child.Name == "RiceRow" then
			child.Transparency = if visible then 0 else 1
		end
	end
end

local function refreshFarm(farmId: string)
	local farm = book:Get(farmId)
	local view = views[farmId]
	if farm == nil or view == nil then
		return
	end
	local definition = farm.definition
	local state: string = farm.state
	local promised = state == "Accepted" or state == "InProgress" or state == "Extended"
	local open = not farm.resolved

	view.model:SetAttribute("State", state)
	view.model:SetAttribute("RemainingBundles", farm.remaining)
	view.model:SetAttribute("DeadlineAt", farm.deadlineAt)
	view.model:SetAttribute("Extended", farm.extended)
	local owner = asPlayer(farm.owner)
	view.model:SetAttribute("OwnerName", if owner then owner.DisplayName else "")

	view.acceptPrompt.Enabled = state == "Available"
	view.rejectPrompt.Enabled = state == "Available"
	syncSheaves(view, farm.remaining, state == "Missed" or state == "Burned")
	-- Only the farm you promised to clear lets you pick up its straw.
	sheafPrompts(view, promised and open and farm.remaining > 0)
	view.extendPrompt.Enabled = promised and open and not farm.extended

	local board = view.board
	board.pillText.Text = STATE_TEXT[state] or string.upper(state)
	board.pill.BackgroundColor3 = STATE_COLORS[state] or MUTED
	if open then
		board.main.Text = string.format(
			"%d/%d bundles  ·  %s",
			farm.remaining,
			definition.Bundles,
			formatClock(farm.deadlineAt - now())
		)
		if world:GetAttribute("WeatherActive") == "Rain" and farm.remaining > 0 then
			-- Spec 11.3: loose straw in the field stays wet while it rains.
			board.detail.Text = "Raining: straw stays wet"
		elseif promised then
			board.detail.Text = if farm.extended
				then "Extended. Pick up sheaves or send a truck"
				else "Pick up sheaves or send a truck"
		else
			board.detail.Text = string.format(
				"Truck %d credits a trip  ·  Burn risk %d",
				definition.RouteFee,
				definition.BurnExposure
			)
		end
	elseif state == "Completed" then
		board.main.Text = "Field cleared"
		board.detail.Text = "All straw collected in time"
	else
		board.main.Text = string.format("%d bundles burned", farm.burnedBundles)
		board.detail.Text = "Smoke drifted downwind"
	end
end

-- One standing sheaf per bundle on the farm's field, picked up by hand once a contract is taken.
-- Called at startup and again whenever the farm replants for a new round.
local function spawnSheaves(farmId: string)
	local view = views[farmId]
	local definition = CommitmentDefinitions.Farms[farmId]
	local model = view.model
	local strawArea = model:FindFirstChild("StrawArea") :: BasePart
	local oldSheaves = model:FindFirstChild("Sheaves")
	if oldSheaves then
		oldSheaves:Destroy()
	end
	table.clear(view.sheaves)
	view.charred = false
	local sheafFolder = Instance.new("Folder")
	sheafFolder.Name = "Sheaves"
	sheafFolder.Parent = model
	for index = 1, definition.Bundles do
		local sheaf, bundle = StrawSheaf.Build(StrawSheaf.GroundFor(strawArea, index), index)
		local prompt = createPrompt(
			bundle,
			"PickUpPrompt",
			"Pick up",
			definition.DisplayName .. " straw",
			Enum.KeyCode.E,
			0.3
		)
		prompt.MaxActivationDistance = 8
		prompt.Enabled = false
		prompt.Triggered:Connect(function(player)
			if sheaf.Parent == nil then
				return
			end
			local ok, reason = book:CanCollect(farmId, now())
			if not ok then
				machineService:Notify(player, reason)
				return
			end
			-- Move this sheaf to the end so the sync removes exactly the one picked up.
			local position = table.find(view.sheaves, sheaf)
			if position then
				table.remove(view.sheaves, position)
				table.insert(view.sheaves, sheaf)
			end
			if CommitmentService:TakeStraw(farmId, 1) > 0 then
				playerState:AddStraw(player, 1)
			end
		end)
		sheaf.Parent = sheafFolder
		table.insert(view.sheaves, sheaf)
	end
end

local function handleEvents(events: { any })
	for _, event in events do
		local farm = book:Get(event.farmId)
		local view = views[event.farmId]
		local definition = farm.definition
		local owner = asPlayer(event.owner)

		if event.type == "Extended" then
			if owner then
				playerState:AdjustCredits(owner, event.credits, "Extension")
			end
		elseif event.type == "Completed" then
			setRiceVisible(view.model, false)
			if owner then
				playerState:AdjustTrust(owner, event.trust)
				playerState:AdjustCredits(owner, event.credits, "Bonus")
				machineService:Notify(
					owner,
					string.format(
						"%s commitment completed: +%d trust, +%d credits reliability bonus%s. The farm replants and will need you again.",
						definition.ShortName,
						event.trust,
						event.credits,
						if (event.streak or 1) > 1
							then string.format(" (%d in a row)", event.streak)
							else ""
					)
				)
			end
		elseif event.type == "Regrown" then
			-- A new harvest: fresh straw, standing rice rows, and a clean burn pad.
			setRiceVisible(view.model, true)
			view.burnPoint.Color = view.burnColor
			spawnSheaves(event.farmId)
			machineService:NotifyAll(
				string.format(
					"%s has harvested again: a new straw contract is open.",
					definition.DisplayName
				)
			)
		elseif event.type == "Burn" then
			setRiceVisible(view.model, false)
			view.burnPoint.Color = Color3.fromRGB(62, 58, 54)
			if owner and event.trust ~= 0 then
				playerState:AdjustTrust(owner, event.trust)
			end
			local responsibility = CommitmentDefinitions.Responsibility[event.responsibility]
				or event.responsibility
			local record = smokeService:BurnField(
				world,
				view.burnPoint,
				event.exposure,
				playerState,
				gameConfig,
				{
					field = definition.DisplayName,
					quantity = event.quantity,
					responsibility = event.responsibility,
				}
			)
			-- Spec 11.4: name the source field, destination, wind, and exposure points.
			machineService:NotifyAll(
				string.format(
					"%s burned %d bundles (%s). Wind %s carries smoke to %s: +%d exposure.%s",
					definition.DisplayName,
					event.quantity,
					responsibility,
					record.wind,
					record.destination,
					record.exposure,
					if event.trust ~= 0 then string.format(" Trust %d.", event.trust) else ""
				)
			)
		end
		refreshFarm(event.farmId)
	end
end

-- Used by trucks and manual collection. Returns how many bundles left the field.
function CommitmentService:TakeStraw(farmId: string, max: number): number
	local taken = book:Take(farmId, max, now())
	handleEvents(book:Drain())
	refreshFarm(farmId)
	return taken
end

function CommitmentService:CanCollect(farmId: string): (boolean, string)
	return book:CanCollect(farmId, now())
end

function CommitmentService:Initialize(
	worldModel: Model,
	playerStateService: any,
	smoke: any,
	machines: any,
	config: any
)
	world = worldModel
	playerState = playerStateService
	smokeService = smoke
	machineService = machines
	gameConfig = config
	book = FarmCommitments.new(CommitmentDefinitions, now())

	for _, farmId in CommitmentDefinitions.FarmOrder do
		local definition = CommitmentDefinitions.Farms[farmId]
		local model = world:FindFirstChild(definition.ModelName, true)
		assert(model and model:IsA("Model"), definition.ModelName .. " is missing from the graybox")
		local collectionPoint = model:FindFirstChild("CollectionPoint")
		local burnPoint = model:FindFirstChild("BurnPoint")
		assert(
			collectionPoint and collectionPoint:IsA("BasePart"),
			definition.ModelName .. " CollectionPoint is missing"
		)
		assert(
			burnPoint and burnPoint:IsA("BasePart"),
			definition.ModelName .. " BurnPoint is missing"
		)

		model:SetAttribute("CommitmentId", farmId)
		model:SetAttribute("DisplayName", definition.DisplayName)
		model:SetAttribute("Bundles", definition.Bundles)
		model:SetAttribute("RouteFee", definition.RouteFee)
		model:SetAttribute("BurnExposure", definition.BurnExposure)

		local view: FarmView = {
			model = model,
			burnPoint = burnPoint,
			board = FarmBoard.Create(collectionPoint, "CommitmentStatus", definition.ShortName),
			acceptPrompt = createPrompt(
				collectionPoint,
				"AcceptPrompt",
				"Accept commitment",
				definition.DisplayName,
				Enum.KeyCode.E,
				0.5
			),
			rejectPrompt = createPrompt(
				collectionPoint,
				"RejectPrompt",
				"Reject commitment",
				definition.DisplayName,
				Enum.KeyCode.T,
				1.5
			),
			extendPrompt = createPrompt(
				collectionPoint,
				"ExtendPrompt",
				string.format("Request extension (%d credits)", CommitmentDefinitions.ExtensionFee),
				definition.DisplayName,
				Enum.KeyCode.Y,
				1
			),
			sheaves = {},
			charred = false,
			burnColor = burnPoint.Color,
		}
		views[farmId] = view
		-- Accept and reject show together on the same pad; stack them so neither covers the
		-- other (positive Y moves a prompt up). Extend only shows once a promise is made.
		view.acceptPrompt.UIOffset = Vector2.new(0, 40)
		view.rejectPrompt.UIOffset = Vector2.new(0, -40)

		-- Rice rows stay as scenery but no longer block walking down the lanes.
		for _, child in model:GetChildren() do
			if child:IsA("BasePart") and child.Name == "RiceRow" then
				child.CanCollide = false
			end
		end
		local oldCollect = collectionPoint:FindFirstChild("CollectPrompt")
		if oldCollect then
			oldCollect:Destroy()
		end
		local strawArea = model:FindFirstChild("StrawArea")
		assert(
			strawArea and strawArea:IsA("BasePart"),
			definition.ModelName .. " StrawArea is missing"
		)
		spawnSheaves(farmId)

		view.acceptPrompt.Triggered:Connect(function(player)
			if playerState:GetTrust(player) < gameConfig.Smog.RefuseTrust then
				machineService:Notify(
					player,
					string.format(
						"%s does not trust the cooperative enough to sign. Win trust back by keeping other promises.",
						definition.DisplayName
					)
				)
				return
			end
			local _, message = book:Accept(farmId, player)
			machineService:Notify(player, message)
			handleEvents(book:Drain())
			refreshFarm(farmId)
		end)
		view.rejectPrompt.Triggered:Connect(function(player)
			local _, message = book:Reject(farmId, player)
			machineService:Notify(player, message)
			handleEvents(book:Drain())
			refreshFarm(farmId)
		end)
		view.extendPrompt.Triggered:Connect(function(player)
			if playerState:GetCredits(player) < CommitmentDefinitions.ExtensionFee then
				machineService:Notify(
					player,
					string.format(
						"An extension costs %d credits.",
						CommitmentDefinitions.ExtensionFee
					)
				)
				return
			end
			local _, message = book:Extend(farmId, player, now())
			machineService:Notify(player, message)
			handleEvents(book:Drain())
			refreshFarm(farmId)
		end)
		refreshFarm(farmId)
	end

	task.spawn(function()
		while true do
			handleEvents(book:Update(now()))
			for farmId in views do
				refreshFarm(farmId)
			end
			task.wait(UPDATE_SECONDS)
		end
	end)
end

return CommitmentService
]]></ProtectedString>
						<string name="ScriptGuid">{50D93095-DF9E-4F0F-A576-0A5CD6941554}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">CommitmentService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f00001f17</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXF488A2B3D9184AB3B86D2CE0B17E9D23">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- Truck route terminals (spec v0.2 section 7.4, P0 simplified route).
-- Trip logic lives in Simulation/TruckRoute. This service draws the truck on the road, takes
-- straw through CommitmentService, unloads into the factory intake, and charges route fees.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CommitmentDefinitions = require(Shared:WaitForChild("CommitmentDefinitions"))

local Simulation = script.Parent.Parent:WaitForChild("Simulation")
local TruckRoute = require(Simulation:WaitForChild("TruckRoute"))

local TruckService = {}

local TICK_SECONDS = 0.2
local TRUCK_HEIGHT = 3

type Truck = {
	route: any,
	record: any,
	owner: Player?,
	body: BasePart,
	label: TextLabel,
	lastState: string,
}

local trucks: { [number]: Truck } = {}
local world: Model
local playerState: any
local machineService: any
local commitmentService: any
local truckFolder: Folder

local function formatClock(seconds: number): string
	local whole = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

local function readable(state: string): string
	return (string.gsub(state, "(%l)(%u)", "%1 %2"))
end

local function findPart(name: string): BasePart?
	local found = world:FindFirstChild(name, true)
	return if found and found:IsA("BasePart") then found else nil
end

-- Road path from the terminal to the fixed farm stop. Farm stops never move (spec 7.4), so
-- distance and deadlines stay predictable. Pathfinding is out of scope for the demo.
local function buildPath(terminalBody: BasePart, farmId: string): { Vector3 }
	local start = terminalBody.Position
	local y = TRUCK_HEIGHT
	local path = { Vector3.new(start.X, y, start.Z) }
	local factoryRoad = findPart("FactoryRoad")
	local mainRoad = findPart("MainRoad")
	local definition = CommitmentDefinitions.Farms[farmId]
	local farm = world:FindFirstChild(definition.ModelName, true)
	local stop = if farm then farm:FindFirstChild("CollectionPoint") else nil
	local stopPosition = if stop and stop:IsA("BasePart") then stop.Position else start
	if factoryRoad and mainRoad then
		table.insert(path, Vector3.new(factoryRoad.Position.X, y, start.Z))
		table.insert(path, Vector3.new(factoryRoad.Position.X, y, mainRoad.Position.Z))
		table.insert(path, Vector3.new(stopPosition.X, y, mainRoad.Position.Z))
	end
	table.insert(path, Vector3.new(stopPosition.X, y, stopPosition.Z + 8))
	return path
end

local function pointAlong(path: { Vector3 }, alpha: number): (Vector3, Vector3)
	local total = 0
	for index = 2, #path do
		total += (path[index] - path[index - 1]).Magnitude
	end
	local target = math.clamp(alpha, 0, 1) * total
	for index = 2, #path do
		local a, b = path[index - 1], path[index]
		local length = (b - a).Magnitude
		if target <= length or index == #path then
			local t = if length > 0 then math.clamp(target / length, 0, 1) else 1
			return a:Lerp(b, t), if length > 0 then (b - a).Unit else Vector3.zAxis
		end
		target -= length
	end
	return path[1], Vector3.zAxis
end

local function describe(truck: Truck): string
	local route = truck.route
	local farm = if route.farmId then CommitmentDefinitions.Farms[route.farmId] else nil
	return string.format(
		"Truck route terminal: %s\n%s\nRoute: %s | Cargo %d/%d%s",
		string.upper(readable(route.state)),
		route.reason,
		if farm
			then string.format("%s, %d credits per trip", farm.ShortName, farm.RouteFee)
			else "none",
		route.cargo,
		CommitmentDefinitions.Truck.Capacity,
		if route.state ~= "Idle" then " | ETA " .. formatClock(route:EtaSeconds()) else ""
	)
end

local function refreshTruck(truck: Truck)
	local route = truck.route
	local farmId = route.farmId
	local terminalBody = truck.record.model.PrimaryPart
	if farmId == nil or terminalBody == nil then
		return
	end
	local position, direction = pointAlong(buildPath(terminalBody, farmId), route.position)
	local facing = if route.state == "Returning" then -direction else direction
	truck.body.CFrame = CFrame.lookAt(position, position + Vector3.new(facing.X, 0, facing.Z))
	local farm = CommitmentDefinitions.Farms[farmId]
	truck.label.Text = string.format(
		"%s\n%s | %d/%d bundles%s",
		string.upper(readable(route.state)),
		farm.ShortName,
		route.cargo,
		CommitmentDefinitions.Truck.Capacity,
		if route.state ~= "Idle" then " | " .. formatClock(route:EtaSeconds()) else ""
	)
end

local function createTruckBody(): (BasePart, TextLabel)
	local body = Instance.new("Part")
	body.Name = "Truck"
	body.Size = Vector3.new(7, 5, 12)
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.Material = Enum.Material.SmoothPlastic
	body.Color = Color3.fromRGB(214, 120, 52)
	body.Parent = truckFolder

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Status"
	billboard.Size = UDim2.fromOffset(200, 54)
	billboard.StudsOffset = Vector3.new(0, 6, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 260
	billboard.Parent = body

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(20, 29, 25)
	label.BackgroundTransparency = 0.15
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(247, 241, 220)
	label.TextScaled = true
	label.Parent = billboard
	return body, label
end

local function createPrompt(
	parent: BasePart,
	name: string,
	actionText: string,
	key: Enum.KeyCode,
	holdDuration: number
): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = actionText
	prompt.ObjectText = "Truck route terminal"
	prompt.KeyboardKeyCode = key
	prompt.HoldDuration = holdDuration
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

local function ownsTruck(player: Player, truck: Truck): boolean
	if truck.owner ~= player then
		machineService:Notify(player, "You can only operate your own truck terminal.")
		return false
	end
	return true
end

local function switchFarm(player: Player, truck: Truck)
	if not ownsTruck(player, truck) then
		return
	end
	local order = CommitmentDefinitions.FarmOrder
	local index = table.find(order, truck.route.farmId) or 0
	local nextFarm = order[index % #order + 1]
	local _, message = truck.route:Assign(nextFarm)
	machineService:Notify(player, message)
end

local function dispatch(player: Player, truck: Truck)
	if not ownsTruck(player, truck) then
		return
	end
	local farmId = truck.route.farmId
	if farmId then
		local canCollect, reason = commitmentService:CanCollect(farmId)
		if not canCollect then
			machineService:Notify(player, "Route blocked: " .. reason)
			return
		end
		local fee = CommitmentDefinitions.Farms[farmId].RouteFee
		if playerState:GetCredits(player) < fee then
			machineService:Notify(
				player,
				string.format("This route costs %d credits per trip.", fee)
			)
			return
		end
	end
	local _, message = truck.route:Dispatch()
	machineService:Notify(player, message)
end

local function handleEvents(truck: Truck, events: { any })
	local owner = truck.owner
	for _, event in events do
		local farm = CommitmentDefinitions.Farms[event.farmId]
		if event.type == "Loaded" then
			machineService:Notify(
				owner,
				string.format("Truck loaded %d bundles at %s.", event.cargo, farm.ShortName)
			)
		elseif event.type == "TripCompleted" then
			if owner and owner.Parent then
				playerState:AdjustCredits(owner, -event.fee, "RouteFee")
			end
			machineService:Notify(
				owner,
				string.format(
					"Trip complete: %d bundles from %s delivered. Route fee -%d credits.",
					event.cargo,
					farm.ShortName,
					event.fee
				)
			)
		end
	end
	local state = truck.route.state
	if state ~= truck.lastState then
		if state == "DestinationFull" then
			machineService:Notify(owner, "Truck waiting: the factory collection point is full.")
		elseif state == "RouteBlocked" then
			machineService:Notify(owner, "Route blocked: no straw ready at the farm stop.")
		end
		truck.lastState = state
	end
end

local function onPlaced(record: any)
	local body = record.model.PrimaryPart
	local truckBody, label = createTruckBody()
	local owner = record.owner
	local truck: Truck = {
		route = TruckRoute.new(CommitmentDefinitions.Truck, CommitmentDefinitions.Farms),
		record = record,
		owner = owner,
		body = truckBody,
		label = label,
		lastState = "Idle",
	}
	truck.route:Assign(CommitmentDefinitions.FarmOrder[1])
	trucks[record.node.id] = truck

	createPrompt(body, "RoutePrompt", "Switch farm stop", Enum.KeyCode.E, 0).Triggered:Connect(
		function(player)
			switchFarm(player, truck)
		end
	)
	createPrompt(body, "DispatchPrompt", "Dispatch truck", Enum.KeyCode.F, 0.5).Triggered:Connect(
		function(player)
			dispatch(player, truck)
		end
	)
	createPrompt(body, "CancelPrompt", "Cancel trip", Enum.KeyCode.V, 0.5).Triggered:Connect(
		function(player)
			if ownsTruck(player, truck) then
				local _, message = truck.route:Cancel()
				machineService:Notify(player, message)
			end
		end
	)
	refreshTruck(truck)
end

function TruckService:Initialize(
	worldModel: Model,
	playerStateService: any,
	machines: any,
	commitments: any
)
	world = worldModel
	playerState = playerStateService
	machineService = machines
	commitmentService = commitments

	local existing = world:FindFirstChild("Trucks")
	if existing then
		existing:Destroy()
	end
	truckFolder = Instance.new("Folder")
	truckFolder.Name = "Trucks"
	truckFolder.Parent = world

	machineService:RegisterKindHandler("Terminal", {
		onPlaced = onPlaced,
		canDismantle = function(record: any): (boolean, string)
			local truck = trucks[record.node.id]
			if truck and truck.route.state ~= "Idle" then
				return false, "Wait for the truck to finish its trip before dismantling."
			end
			return true, ""
		end,
		onRemoved = function(record: any)
			local truck = trucks[record.node.id]
			if truck then
				truck.body:Destroy()
				trucks[record.node.id] = nil
			end
		end,
		describe = function(record: any): string
			local truck = trucks[record.node.id]
			return if truck then describe(truck) else record.node.definition.DisplayName
		end,
	})

	local accumulated = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulated += dt
		if accumulated < TICK_SECONDS then
			return
		end
		local step = accumulated
		accumulated = 0
		for _, truck in trucks do
			local events = truck.route:Step(step, {
				take = function(farmId: string, max: number): number
					return commitmentService:TakeStraw(farmId, max)
				end,
				unload = function(count: number): number
					return machineService:DepositToIntake(count, truck.owner)
				end,
			})
			handleEvents(truck, events)
			refreshTruck(truck)
		end
	end)
end

return TruckService
]]></ProtectedString>
						<string name="ScriptGuid">{3AF655AB-A800-4B8E-BA2D-505265F87C07}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">TruckService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f00001f19</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX16AD964D53F74638A63DD0B51A75FEC0">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- Keeps world labels readable as the district fills up. Billboards that were sized in pixels
-- (farm boards, map signs, trucks, belt warnings) become sized in studs, so they shrink with
-- distance like the objects they describe, and they stop drawing through buildings and machines.
-- Labels already sized in studs are left alone.

local WorldLabelService = {}

local PIXELS_PER_STUD = 18
local MAX_DISTANCE = 180

local function restyle(billboard: BillboardGui)
	local size = billboard.Size
	if size.X.Scale ~= 0 or size.Y.Scale ~= 0 then
		return
	end
	billboard.Size =
		UDim2.fromScale(size.X.Offset / PIXELS_PER_STUD, size.Y.Offset / PIXELS_PER_STUD)
	billboard.AlwaysOnTop = false
	billboard.LightInfluence = 0
	billboard.MaxDistance = if billboard.MaxDistance > 0
		then math.min(billboard.MaxDistance, MAX_DISTANCE)
		else MAX_DISTANCE
	-- Fixed pixel text would overflow a stud-sized board at a distance.
	for _, descendant in billboard:GetDescendants() do
		if descendant:IsA("TextLabel") then
			descendant.TextScaled = true
		end
	end
end

function WorldLabelService:Initialize(world: Model)
	for _, descendant in world:GetDescendants() do
		if descendant:IsA("BillboardGui") then
			restyle(descendant)
		end
	end
	world.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BillboardGui") then
			-- Let the creator finish setting Size and text before restyling.
			task.defer(restyle, descendant)
		end
	end)
end

return WorldLabelService
]]></ProtectedString>
						<string name="ScriptGuid">{00875E41-112D-481A-AD99-96584C1E10AC}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">WorldLabelService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f0000494d</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXB0D601494829476D9B25D08828121D05">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- A harvested rice straw sheaf the player walks up to and picks up: one sheaf is one bundle.
-- Built from parts in the low-poly machine style, so no mesh upload is needed.

local StrawSheaf = {}

local STRAW = Color3.fromRGB(226, 185, 83)
local STRAW_LIGHT = Color3.fromRGB(240, 208, 118)
local TIE = Color3.fromRGB(139, 98, 52)
local CHARRED = Color3.fromRGB(46, 40, 35)
-- Sheaves stand in the lanes between rice rows, at varied depths so the field looks harvested.
local LANE_SPACING = 9
local LANE_COUNT = 8
local SHEAF_DEPTHS = { -20, 12, -6, 22, -14, 4, 18, -24 }

local function part(model: Model, name: string, size: Vector3, cframe: CFrame, color: Color3): Part
	local item = Instance.new("Part")
	item.Name = name
	item.Size = size
	item.CFrame = cframe
	item.Color = color
	item.Material = Enum.Material.Grass
	item.Anchored = true
	item.CanCollide = false
	item.CanTouch = false
	item.TopSurface = Enum.SurfaceType.Smooth
	item.BottomSurface = Enum.SurfaceType.Smooth
	item.Parent = model
	return item
end

local function upright(base: CFrame, height: number): CFrame
	-- Part cylinders run along X, so turn them to stand up.
	return base * CFrame.new(0, height, 0) * CFrame.Angles(0, 0, math.rad(90))
end

-- `groundCFrame` is the point on the ground where the sheaf stands; `seed` varies its lean.
function StrawSheaf.Build(groundCFrame: CFrame, seed: number): (Model, BasePart)
	local model = Instance.new("Model")
	model.Name = "StrawSheaf"
	local random = Random.new(seed)
	local base = groundCFrame
		* CFrame.Angles(0, random:NextNumber(0, math.pi * 2), 0)
		* CFrame.Angles(math.rad(random:NextNumber(-6, 6)), 0, math.rad(random:NextNumber(-6, 6)))

	part(model, "Foot", Vector3.new(0.5, 2.1, 2.1), upright(base, 0.25), STRAW)
	local body = part(model, "Bundle", Vector3.new(2.8, 1.7, 1.7), upright(base, 1.7), STRAW)
	local tie = part(model, "Tie", Vector3.new(0.35, 1.85, 1.85), upright(base, 1.9), TIE)
	tie.Material = Enum.Material.Fabric
	part(model, "Tuft", Vector3.new(0.7, 2.3, 2.3), upright(base, 3.3), STRAW_LIGHT)
	for index = 1, 3 do
		local angle = index * math.pi * 2 / 3
		part(
			model,
			"Stalk" .. index,
			Vector3.new(0.15, 1.4, 0.15),
			base
				* CFrame.new(math.cos(angle) * 0.6, 3.9, math.sin(angle) * 0.6)
				* CFrame.Angles(math.sin(angle) * 0.5, 0, -math.cos(angle) * 0.5),
			STRAW_LIGHT
		)
	end

	model.PrimaryPart = body
	return model, body
end

-- Where sheaf number `index` stands on a field's StrawArea. Each pass over the lanes shifts the
-- depth pattern, so fields with more than one sheaf per lane never stack two in one spot.
function StrawSheaf.GroundFor(strawArea: BasePart, index: number): CFrame
	local lane = (index - 1) % LANE_COUNT
	local pass = (index - 1) // LANE_COUNT
	local x = (lane - (LANE_COUNT - 1) / 2) * LANE_SPACING
	local z = SHEAF_DEPTHS[(lane + pass * 3) % #SHEAF_DEPTHS + 1]
	return strawArea.CFrame * CFrame.new(x, strawArea.Size.Y / 2, z)
end

-- Burned straw is left as charred stubs so the field shows what happened.
function StrawSheaf.Char(model: Model)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Color = CHARRED
			descendant.Material = Enum.Material.Slate
		elseif descendant:IsA("ProximityPrompt") then
			descendant.Enabled = false
		end
	end
end

return StrawSheaf
]]></ProtectedString>
						<string name="ScriptGuid">{20403D02-EFA8-49BD-A79E-9524748D0BD5}</string>
