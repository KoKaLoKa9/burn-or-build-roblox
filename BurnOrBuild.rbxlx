	<Item class="StarterGui" referent="RBXD976D6F682C045CF9CB79E4C17041C53">
		<Properties>
			<token name="ClipsDescendantsSupportsRotation">0</token>
			<bool name="ResetPlayerGuiOnSpawn">true</bool>
			<token name="RtlTextSupport">0</token>
