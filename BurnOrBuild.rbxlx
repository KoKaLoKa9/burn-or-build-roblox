						<ProtectedString name="Source"><![CDATA[--!strict

-- Neighboring farm commitments for Farm_B and Farm_C (spec v0.2 section 10).
-- The rules live in Simulation/FarmCommitments; this service owns prompts, billboards,
-- rewards, and burns. Missed or unserved farms burn through SmokeService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CommitmentDefinitions = require(Shared:WaitForChild("CommitmentDefinitions"))

local Simulation = script.Parent.Parent:WaitForChild("Simulation")
local FarmCommitments = require(Simulation:WaitForChild("FarmCommitments"))

local CommitmentService = {}

local UPDATE_SECONDS = 0.5

type FarmView = {
	model: Model,
	burnPoint: BasePart,
	label: TextLabel,
	acceptPrompt: ProximityPrompt,
	rejectPrompt: ProximityPrompt,
	collectPrompt: ProximityPrompt,
	extendPrompt: ProximityPrompt,
}

local book: any
local views: { [string]: FarmView } = {}
local world: Model
local playerState: any
local smokeService: any
local machineService: any
local gameConfig: any

local STATE_TEXT: { [string]: string } = {
	Available = "AVAILABLE",
	Accepted = "ACCEPTED",
	Rejected = "REJECTED",
	InProgress = "IN PROGRESS",
	Completed = "COMPLETED",
	Missed = "MISSED, BURNED",
	Extended = "EXTENDED",
	Burned = "BURNED, NO PROMISE",
}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function asPlayer(owner: any): Player?
	if typeof(owner) == "Instance" and owner:IsA("Player") and owner.Parent ~= nil then
		return owner
	end
	return nil
end

local function formatClock(seconds: number): string
	local whole = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

local function createPrompt(
	parent: BasePart,
	name: string,
	actionText: string,
	objectText: string,
	key: Enum.KeyCode,
	holdDuration: number
): ProximityPrompt
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.KeyboardKeyCode = key
	prompt.HoldDuration = holdDuration
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

local function createStatusLabel(parent: BasePart): TextLabel
	local existing = parent:FindFirstChild("CommitmentStatus")
	if existing then
		existing:Destroy()
	end
	-- The graybox label said FUTURE CONTRACT; the live status replaces it.
	local mapLabel = parent:FindFirstChild("MapLabel")
	if mapLabel and mapLabel:IsA("BillboardGui") then
		mapLabel.Enabled = false
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "CommitmentStatus"
	billboard.Size = UDim2.fromOffset(300, 120)
	billboard.StudsOffset = Vector3.new(0, 9, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 220
	billboard.Parent = parent

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(20, 29, 25)
	label.BackgroundTransparency = 0.12
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(247, 241, 220)
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = label
	return label
end

local function setRiceVisible(model: Model, visible: boolean)
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") and child.Name == "RiceRow" then
			child.Transparency = if visible then 0 else 1
		end
	end
end

local function refreshFarm(farmId: string)
	local farm = book:Get(farmId)
	local view = views[farmId]
	if farm == nil or view == nil then
		return
	end
	local definition = farm.definition
	local state: string = farm.state
	local promised = state == "Accepted" or state == "InProgress" or state == "Extended"
	local open = not farm.resolved

	view.model:SetAttribute("State", state)
	view.model:SetAttribute("RemainingBundles", farm.remaining)
	view.model:SetAttribute("DeadlineAt", farm.deadlineAt)
	view.model:SetAttribute("Extended", farm.extended)
	local owner = asPlayer(farm.owner)
	view.model:SetAttribute("OwnerName", if owner then owner.DisplayName else "")

	view.acceptPrompt.Enabled = state == "Available"
	view.rejectPrompt.Enabled = state == "Available"
	view.collectPrompt.Enabled = promised and open and farm.remaining > 0
	view.extendPrompt.Enabled = promised and open and not farm.extended

	local lines = { string.format("%s: %s", definition.DisplayName, STATE_TEXT[state] or state) }
	if open then
		table.insert(
			lines,
			string.format(
				"%d of %d bundles left | deadline in %s%s",
				farm.remaining,
				definition.Bundles,
				formatClock(farm.deadlineAt - now()),
				if farm.extended then " (extended)" else ""
			)
		)
		table.insert(
			lines,
			string.format(
				"Truck %d s each way, %d credits per trip | Burn risk %d exposure",
				definition.TravelSeconds,
				definition.RouteFee,
				definition.BurnExposure
			)
		)
		if world:GetAttribute("WeatherActive") == "Rain" and farm.remaining > 0 then
			-- Spec 11.3: loose straw in the field stays wet while it rains.
			table.insert(lines, "Raining: loose straw stays wet, dryers run slower")
		end
		if state == "Available" then
			table.insert(lines, "[E] accept   hold [T] reject")
		elseif promised then
			table.insert(
				lines,
				if farm.extended
					then "[E] collect 1 bundle"
					else string.format(
						"[E] collect 1 bundle   hold [Y] extend (%d credits)",
						CommitmentDefinitions.ExtensionFee
					)
			)
		end
	elseif state == "Completed" then
		table.insert(lines, "All straw collected before the deadline")
	else
		table.insert(lines, string.format("%d bundles burned", farm.burnedBundles))
	end
	view.label.Text = table.concat(lines, "\n")
end

local function handleEvents(events: { any })
	for _, event in events do
		local farm = book:Get(event.farmId)
		local view = views[event.farmId]
		local definition = farm.definition
		local owner = asPlayer(event.owner)

		if event.type == "Extended" then
			if owner then
				playerState:AdjustCredits(owner, event.credits, "Extension")
			end
		elseif event.type == "Completed" then
			setRiceVisible(view.model, false)
			if owner then
				playerState:AdjustTrust(owner, event.trust)
				playerState:AdjustCredits(owner, event.credits, "Bonus")
				machineService:Notify(
					owner,
					string.format(
						"%s commitment completed: +%d trust, +%d credits reliability bonus.",
						definition.ShortName,
						event.trust,
						event.credits
					)
				)
			end
		elseif event.type == "Burn" then
			setRiceVisible(view.model, false)
			view.burnPoint.Color = Color3.fromRGB(62, 58, 54)
			if owner and event.trust ~= 0 then
				playerState:AdjustTrust(owner, event.trust)
			end
			local responsibility = CommitmentDefinitions.Responsibility[event.responsibility]
				or event.responsibility
			local record = smokeService:BurnField(
				world,
				view.burnPoint,
				event.exposure,
				playerState,
				gameConfig,
				{
					field = definition.DisplayName,
					quantity = event.quantity,
					responsibility = event.responsibility,
				}
			)
			-- Spec 11.4: name the source field, destination, wind, and exposure points.
			machineService:NotifyAll(
				string.format(
					"%s burned %d bundles (%s). Wind %s carries smoke to %s: +%d exposure.%s",
					definition.DisplayName,
					event.quantity,
					responsibility,
					record.wind,
					record.destination,
					record.exposure,
					if event.trust ~= 0 then string.format(" Trust %d.", event.trust) else ""
				)
			)
		end
		refreshFarm(event.farmId)
	end
end

-- Used by trucks and manual collection. Returns how many bundles left the field.
function CommitmentService:TakeStraw(farmId: string, max: number): number
	local taken = book:Take(farmId, max, now())
	handleEvents(book:Drain())
	refreshFarm(farmId)
	return taken
end

function CommitmentService:CanCollect(farmId: string): (boolean, string)
	return book:CanCollect(farmId, now())
end

function CommitmentService:Initialize(
	worldModel: Model,
	playerStateService: any,
	smoke: any,
	machines: any,
	config: any
)
	world = worldModel
	playerState = playerStateService
	smokeService = smoke
	machineService = machines
	gameConfig = config
	book = FarmCommitments.new(CommitmentDefinitions, now())

	for _, farmId in CommitmentDefinitions.FarmOrder do
		local definition = CommitmentDefinitions.Farms[farmId]
		local model = world:FindFirstChild(definition.ModelName, true)
		assert(model and model:IsA("Model"), definition.ModelName .. " is missing from the graybox")
		local collectionPoint = model:FindFirstChild("CollectionPoint")
		local burnPoint = model:FindFirstChild("BurnPoint")
		assert(
			collectionPoint and collectionPoint:IsA("BasePart"),
			definition.ModelName .. " CollectionPoint is missing"
		)
		assert(
			burnPoint and burnPoint:IsA("BasePart"),
			definition.ModelName .. " BurnPoint is missing"
		)

		model:SetAttribute("CommitmentId", farmId)
		model:SetAttribute("DisplayName", definition.DisplayName)
		model:SetAttribute("Bundles", definition.Bundles)
		model:SetAttribute("RouteFee", definition.RouteFee)
		model:SetAttribute("BurnExposure", definition.BurnExposure)

		local view: FarmView = {
			model = model,
			burnPoint = burnPoint,
			label = createStatusLabel(collectionPoint),
			acceptPrompt = createPrompt(
				collectionPoint,
				"AcceptPrompt",
				"Accept commitment",
				definition.DisplayName,
				Enum.KeyCode.E,
				0.5
			),
			rejectPrompt = createPrompt(
				collectionPoint,
				"RejectPrompt",
				"Reject commitment",
				definition.DisplayName,
				Enum.KeyCode.T,
				1.5
			),
			collectPrompt = createPrompt(
				collectionPoint,
				"CollectPrompt",
				"Collect 1 bundle",
				definition.DisplayName,
				Enum.KeyCode.E,
				0.25
			),
			extendPrompt = createPrompt(
				collectionPoint,
				"ExtendPrompt",
				string.format("Request extension (%d credits)", CommitmentDefinitions.ExtensionFee),
				definition.DisplayName,
				Enum.KeyCode.Y,
				1
			),
		}
		views[farmId] = view

		view.acceptPrompt.Triggered:Connect(function(player)
			local _, message = book:Accept(farmId, player)
			machineService:Notify(player, message)
			handleEvents(book:Drain())
			refreshFarm(farmId)
		end)
		view.rejectPrompt.Triggered:Connect(function(player)
			local _, message = book:Reject(farmId, player)
			machineService:Notify(player, message)
			handleEvents(book:Drain())
			refreshFarm(farmId)
		end)
		view.collectPrompt.Triggered:Connect(function(player)
			local ok, reason = book:CanCollect(farmId, now())
			if not ok then
				machineService:Notify(player, reason)
				return
			end
			if self:TakeStraw(farmId, 1) > 0 then
				playerState:AddStraw(player, 1)
			end
		end)
		view.extendPrompt.Triggered:Connect(function(player)
			if playerState:GetCredits(player) < CommitmentDefinitions.ExtensionFee then
				machineService:Notify(
					player,
					string.format(
						"An extension costs %d credits.",
						CommitmentDefinitions.ExtensionFee
					)
				)
				return
			end
			local _, message = book:Extend(farmId, player, now())
			machineService:Notify(player, message)
			handleEvents(book:Drain())
			refreshFarm(farmId)
		end)
		refreshFarm(farmId)
	end

	task.spawn(function()
		while true do
			handleEvents(book:Update(now()))
			for farmId in views do
				refreshFarm(farmId)
			end
			task.wait(UPDATE_SECONDS)
		end
	end)
end

return CommitmentService
]]></ProtectedString>
						<string name="ScriptGuid">{50D93095-DF9E-4F0F-A576-0A5CD6941554}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">CommitmentService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f00001f17</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXF488A2B3D9184AB3B86D2CE0B17E9D23">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- Truck route terminals (spec v0.2 section 7.4, P0 simplified route).
-- Trip logic lives in Simulation/TruckRoute. This service draws the truck on the road, takes
-- straw through CommitmentService, unloads into the factory intake, and charges route fees.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CommitmentDefinitions = require(Shared:WaitForChild("CommitmentDefinitions"))

local Simulation = script.Parent.Parent:WaitForChild("Simulation")
local TruckRoute = require(Simulation:WaitForChild("TruckRoute"))

local TruckService = {}

local TICK_SECONDS = 0.2
local TRUCK_HEIGHT = 3

type Truck = {
	route: any,
	record: any,
	owner: Player?,
	body: BasePart,
	label: TextLabel,
	lastState: string,
}

local trucks: { [number]: Truck } = {}
local world: Model
local playerState: any
local machineService: any
local commitmentService: any
local truckFolder: Folder

local function formatClock(seconds: number): string
	local whole = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

local function readable(state: string): string
	return (string.gsub(state, "(%l)(%u)", "%1 %2"))
end

local function findPart(name: string): BasePart?
	local found = world:FindFirstChild(name, true)
	return if found and found:IsA("BasePart") then found else nil
end

-- Road path from the terminal to the fixed farm stop. Farm stops never move (spec 7.4), so
-- distance and deadlines stay predictable. Pathfinding is out of scope for the demo.
local function buildPath(terminalBody: BasePart, farmId: string): { Vector3 }
	local start = terminalBody.Position
	local y = TRUCK_HEIGHT
	local path = { Vector3.new(start.X, y, start.Z) }
	local factoryRoad = findPart("FactoryRoad")
	local mainRoad = findPart("MainRoad")
	local definition = CommitmentDefinitions.Farms[farmId]
	local farm = world:FindFirstChild(definition.ModelName, true)
	local stop = if farm then farm:FindFirstChild("CollectionPoint") else nil
	local stopPosition = if stop and stop:IsA("BasePart") then stop.Position else start
	if factoryRoad and mainRoad then
		table.insert(path, Vector3.new(factoryRoad.Position.X, y, start.Z))
		table.insert(path, Vector3.new(factoryRoad.Position.X, y, mainRoad.Position.Z))
		table.insert(path, Vector3.new(stopPosition.X, y, mainRoad.Position.Z))
	end
	table.insert(path, Vector3.new(stopPosition.X, y, stopPosition.Z + 8))
	return path
end

local function pointAlong(path: { Vector3 }, alpha: number): (Vector3, Vector3)
	local total = 0
	for index = 2, #path do
		total += (path[index] - path[index - 1]).Magnitude
	end
	local target = math.clamp(alpha, 0, 1) * total
	for index = 2, #path do
		local a, b = path[index - 1], path[index]
		local length = (b - a).Magnitude
		if target <= length or index == #path then
			local t = if length > 0 then math.clamp(target / length, 0, 1) else 1
			return a:Lerp(b, t), if length > 0 then (b - a).Unit else Vector3.zAxis
		end
		target -= length
	end
	return path[1], Vector3.zAxis
end

local function describe(truck: Truck): string
	local route = truck.route
	local farm = if route.farmId then CommitmentDefinitions.Farms[route.farmId] else nil
	return string.format(
		"Truck route terminal: %s\n%s\nRoute: %s | Cargo %d/%d%s",
		string.upper(readable(route.state)),
		route.reason,
		if farm
			then string.format("%s, %d credits per trip", farm.ShortName, farm.RouteFee)
			else "none",
		route.cargo,
		CommitmentDefinitions.Truck.Capacity,
		if route.state ~= "Idle" then " | ETA " .. formatClock(route:EtaSeconds()) else ""
	)
end

local function refreshTruck(truck: Truck)
	local route = truck.route
	local farmId = route.farmId
	local terminalBody = truck.record.model.PrimaryPart
	if farmId == nil or terminalBody == nil then
		return
	end
	local position, direction = pointAlong(buildPath(terminalBody, farmId), route.position)
	local facing = if route.state == "Returning" then -direction else direction
	truck.body.CFrame = CFrame.lookAt(position, position + Vector3.new(facing.X, 0, facing.Z))
	local farm = CommitmentDefinitions.Farms[farmId]
	truck.label.Text = string.format(
		"%s\n%s | %d/%d bundles%s",
		string.upper(readable(route.state)),
		farm.ShortName,
		route.cargo,
		CommitmentDefinitions.Truck.Capacity,
		if route.state ~= "Idle" then " | " .. formatClock(route:EtaSeconds()) else ""
	)
end

local function createTruckBody(): (BasePart, TextLabel)
	local body = Instance.new("Part")
	body.Name = "Truck"
	body.Size = Vector3.new(7, 5, 12)
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.Material = Enum.Material.SmoothPlastic
	body.Color = Color3.fromRGB(214, 120, 52)
	body.Parent = truckFolder

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Status"
	billboard.Size = UDim2.fromOffset(200, 54)
	billboard.StudsOffset = Vector3.new(0, 6, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 260
	billboard.Parent = body

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(20, 29, 25)
	label.BackgroundTransparency = 0.15
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(247, 241, 220)
	label.TextScaled = true
	label.Parent = billboard
	return body, label
end

local function createPrompt(
	parent: BasePart,
	name: string,
	actionText: string,
	key: Enum.KeyCode,
	holdDuration: number
): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = actionText
	prompt.ObjectText = "Truck route terminal"
	prompt.KeyboardKeyCode = key
	prompt.HoldDuration = holdDuration
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

local function ownsTruck(player: Player, truck: Truck): boolean
	if truck.owner ~= player then
		machineService:Notify(player, "You can only operate your own truck terminal.")
		return false
	end
	return true
end

local function switchFarm(player: Player, truck: Truck)
	if not ownsTruck(player, truck) then
		return
	end
	local order = CommitmentDefinitions.FarmOrder
	local index = table.find(order, truck.route.farmId) or 0
	local nextFarm = order[index % #order + 1]
	local _, message = truck.route:Assign(nextFarm)
	machineService:Notify(player, message)
end

local function dispatch(player: Player, truck: Truck)
	if not ownsTruck(player, truck) then
		return
	end
	local farmId = truck.route.farmId
	if farmId then
		local canCollect, reason = commitmentService:CanCollect(farmId)
		if not canCollect then
			machineService:Notify(player, "Route blocked: " .. reason)
			return
		end
		local fee = CommitmentDefinitions.Farms[farmId].RouteFee
		if playerState:GetCredits(player) < fee then
			machineService:Notify(
				player,
				string.format("This route costs %d credits per trip.", fee)
			)
			return
		end
	end
	local _, message = truck.route:Dispatch()
	machineService:Notify(player, message)
end

local function handleEvents(truck: Truck, events: { any })
	local owner = truck.owner
	for _, event in events do
		local farm = CommitmentDefinitions.Farms[event.farmId]
		if event.type == "Loaded" then
			machineService:Notify(
				owner,
				string.format("Truck loaded %d bundles at %s.", event.cargo, farm.ShortName)
			)
		elseif event.type == "TripCompleted" then
			if owner and owner.Parent then
				playerState:AdjustCredits(owner, -event.fee, "RouteFee")
			end
			machineService:Notify(
				owner,
				string.format(
					"Trip complete: %d bundles from %s delivered. Route fee -%d credits.",
					event.cargo,
					farm.ShortName,
					event.fee
				)
			)
		end
	end
	local state = truck.route.state
	if state ~= truck.lastState then
		if state == "DestinationFull" then
			machineService:Notify(owner, "Truck waiting: the factory collection point is full.")
		elseif state == "RouteBlocked" then
			machineService:Notify(owner, "Route blocked: no straw ready at the farm stop.")
		end
		truck.lastState = state
	end
end

local function onPlaced(record: any)
	local body = record.model.PrimaryPart
	local truckBody, label = createTruckBody()
	local owner = record.owner
	local truck: Truck = {
		route = TruckRoute.new(CommitmentDefinitions.Truck, CommitmentDefinitions.Farms),
		record = record,
		owner = owner,
		body = truckBody,
		label = label,
		lastState = "Idle",
	}
	truck.route:Assign(CommitmentDefinitions.FarmOrder[1])
	trucks[record.node.id] = truck

	createPrompt(body, "RoutePrompt", "Switch farm stop", Enum.KeyCode.E, 0).Triggered:Connect(
		function(player)
			switchFarm(player, truck)
		end
	)
	createPrompt(body, "DispatchPrompt", "Dispatch truck", Enum.KeyCode.F, 0.5).Triggered:Connect(
		function(player)
			dispatch(player, truck)
		end
	)
	createPrompt(body, "CancelPrompt", "Cancel trip", Enum.KeyCode.V, 0.5).Triggered:Connect(
		function(player)
			if ownsTruck(player, truck) then
				local _, message = truck.route:Cancel()
				machineService:Notify(player, message)
			end
		end
	)
	refreshTruck(truck)
end

function TruckService:Initialize(
	worldModel: Model,
	playerStateService: any,
	machines: any,
	commitments: any
)
	world = worldModel
	playerState = playerStateService
	machineService = machines
	commitmentService = commitments

	local existing = world:FindFirstChild("Trucks")
	if existing then
		existing:Destroy()
	end
	truckFolder = Instance.new("Folder")
	truckFolder.Name = "Trucks"
	truckFolder.Parent = world

	machineService:RegisterKindHandler("Terminal", {
		onPlaced = onPlaced,
		canDismantle = function(record: any): (boolean, string)
			local truck = trucks[record.node.id]
			if truck and truck.route.state ~= "Idle" then
				return false, "Wait for the truck to finish its trip before dismantling."
			end
			return true, ""
		end,
		onRemoved = function(record: any)
			local truck = trucks[record.node.id]
			if truck then
				truck.body:Destroy()
				trucks[record.node.id] = nil
			end
		end,
		describe = function(record: any): string
			local truck = trucks[record.node.id]
			return if truck then describe(truck) else record.node.definition.DisplayName
		end,
	})

	local accumulated = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulated += dt
		if accumulated < TICK_SECONDS then
			return
		end
		local step = accumulated
		accumulated = 0
		for _, truck in trucks do
			local events = truck.route:Step(step, {
				take = function(farmId: string, max: number): number
					return commitmentService:TakeStraw(farmId, max)
				end,
				unload = function(count: number): number
					return machineService:DepositToIntake(count, truck.owner)
				end,
			})
			handleEvents(truck, events)
			refreshTruck(truck)
		end
	end)
end

return TruckService
]]></ProtectedString>
						<string name="ScriptGuid">{3AF655AB-A800-4B8E-BA2D-505265F87C07}</string>
