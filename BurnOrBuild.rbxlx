	PM_HousingStripe = "SafetyYellow",
	PM_InfeedBelt = "Rubber",
	PM_InfeedFoot = "Steel",
	PM_InfeedPost1 = "Steel",
	PM_InfeedPost2 = "Steel",
	PM_InfeedPost3 = "Steel",
	PM_InfeedPost4 = "Steel",
	PM_InfeedRailL = "TealPaint",
	PM_InfeedRailR = "TealPaint",
