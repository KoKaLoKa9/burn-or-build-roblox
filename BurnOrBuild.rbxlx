						<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f00004f0f</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXDA0EA472FD334B35A822D727B86DBF9F">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- The one forecast weather event of the stress phase (spec v0.2 section 11.3).
-- SeasonClock decides when it is forecast, starts, and ends; this service applies it to the
-- world: rain slows dryers and shows rain over the district, a wind shift turns the wind that
-- SmokeService reads for new plumes. State is mirrored to world attributes for the HUD.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SeasonDefinitions = require(Shared:WaitForChild("SeasonDefinitions"))

local Simulation = script.Parent.Parent:WaitForChild("Simulation")
local SeasonClock = require(Simulation:WaitForChild("SeasonClock"))

local WeatherService = {}

local RAIN_HEIGHT = 90

local world: Model
local gameConfig: any
local machineService: any
local seasonStart = 0
local plan: SeasonClock.WeatherPlan? = nil
local lastState = "Calm"
local baseWind: { label: string, x: number, z: number }
local rainCloud: Part? = nil

local function eventDefinition(kind: string): any
	return SeasonDefinitions.Weather[kind]
end

local function setRainVisible(visible: boolean)
	if visible and rainCloud == nil then
		local center, size = world:GetBoundingBox()
		local cloud = Instance.new("Part")
		cloud.Name = "RainCloud"
		cloud.Anchored = true
		cloud.CanCollide = false
		cloud.CanQuery = false
		cloud.CanTouch = false
		cloud.CastShadow = false
		cloud.Transparency = 1
		cloud.Size = Vector3.new(math.min(size.X, 600), 1, math.min(size.Z, 500))
		cloud.Position = Vector3.new(center.Position.X, RAIN_HEIGHT, center.Position.Z)

		local drops = Instance.new("ParticleEmitter")
		drops.Name = "Drops"
		drops.EmissionDirection = Enum.NormalId.Bottom
		drops.Orientation = Enum.ParticleOrientation.VelocityParallel
		drops.Rate = 900
		drops.Lifetime = NumberRange.new(1.4, 1.8)
		drops.Speed = NumberRange.new(60, 70)
		drops.SpreadAngle = Vector2.new(4, 4)
		drops.Size = NumberSequence.new(0.18)
		drops.Squash = NumberSequence.new(-2.5)
		drops.Color = ColorSequence.new(Color3.fromRGB(170, 196, 214))
		drops.Transparency = NumberSequence.new(0.35)
		drops.LightEmission = 0.1
		drops.Parent = cloud
		cloud.Parent = world
		rainCloud = cloud
	elseif not visible and rainCloud then
		rainCloud:Destroy()
		rainCloud = nil
	end
end

local function applyWind(label: string, x: number, z: number, destination: string)
	if gameConfig.Wind.Label == label then
		return
	end
	-- SmokeService reads this table at each ignition, so new plumes follow the new wind.
	gameConfig.Wind.Direction = Vector3.new(x, 0, z)
	gameConfig.Wind.Label = label
	world:SetAttribute("WindDirection", label)
	world:SetAttribute("WindDestination", destination)
end

function WeatherService:Initialize(worldModel: Model, config: any, machines: any, startTime: number)
	world = worldModel
	gameConfig = config
	machineService = machines
	seasonStart = startTime
	local direction: Vector3 = config.Wind.Direction
	baseWind = { label = config.Wind.Label, x = direction.X, z = direction.Z }
	world:SetAttribute("WindDirection", baseWind.label)
	world:SetAttribute("WindDestination", SeasonDefinitions.Weather.BaseWind.Destination)
	world:SetAttribute("WeatherState", "Calm")
	world:SetAttribute("WeatherActive", "")
end

-- Called once the forecast is due. The kind is fixed from then on.
function WeatherService:SetPlan(newPlan: SeasonClock.WeatherPlan)
	plan = newPlan
	local definition = eventDefinition(newPlan.kind)
	world:SetAttribute("WeatherEvent", newPlan.kind)
	world:SetAttribute("WeatherName", definition.Name)
	world:SetAttribute("WeatherStartsAt", seasonStart + newPlan.startsAt)
	world:SetAttribute("WeatherEndsAt", if newPlan.endsAt then seasonStart + newPlan.endsAt else 0)
end

function WeatherService:GetPlan(): SeasonClock.WeatherPlan?
	return plan
end

function WeatherService:Update(elapsed: number)
	local current = plan
	if current == nil then
		return
	end
	local state = SeasonClock.weatherState(current, elapsed)
	local definition = eventDefinition(current.kind)

	machineService:SetCycleMultiplier(
		"Dryer",
		SeasonClock.dryerMultiplier(SeasonDefinitions, current, elapsed)
	)
	local label, x, z, destination =
		SeasonClock.windAt(SeasonDefinitions, current, elapsed, baseWind)
	applyWind(label, x, z, destination)
	setRainVisible(current.kind == "Rain" and state == "Active")

	if state == lastState then
		return
	end
	lastState = state
	world:SetAttribute("WeatherState", state)
	world:SetAttribute("WeatherActive", if state == "Active" then current.kind else "")
	local message = definition[state]
	if typeof(message) == "string" then
		world:SetAttribute("WeatherMessage", message)
		if state == "Forecast" then
			machineService:NotifyAll(
				string.format(
					"Forecast: %s in %s. %s",
					string.lower(definition.Name),
					SeasonClock.formatClock(current.startsAt - elapsed),
					message
				)
			)
		else
			machineService:NotifyAll(message)
		end
	end
end

return WeatherService
]]></ProtectedString>
						<string name="ScriptGuid">{94C898C2-623F-497A-BC22-13EBAEF1DB29}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">WeatherService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f00008514</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXEC1758D3C78C45BAB9F0C72F68D744B7">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- The season loop (spec v0.2 sections 2.3, 11.3, 12.3 to 12.5).
-- Runs the server season clock from GameConfig.Round.DurationSeconds, publishes the phase and
-- time left as world attributes for the HUD, drives the forecast weather event, and builds the
-- end of season report with Simulation/SeasonResults. Players fetch their report through the
-- GetSeasonResults remote once the world attribute SeasonOver turns true.
--
-- Play test helpers (Studio server command bar):
--   workspace.BurnOrBuildWorld:SetAttribute("ForcedWeatherEvent", "Rain") -- or "WindShift",
--     before the forecast at minute 13
--   workspace.BurnOrBuildWorld:SetAttribute("EndSeasonNow", true) -- jump to the results

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CommitmentDefinitions = require(Shared:WaitForChild("CommitmentDefinitions"))
local SeasonDefinitions = require(Shared:WaitForChild("SeasonDefinitions"))

local Simulation = script.Parent.Parent:WaitForChild("Simulation")
local SeasonClock = require(Simulation:WaitForChild("SeasonClock"))
local SeasonResults = require(Simulation:WaitForChild("SeasonResults"))

local SeasonService = {}

local TICK_SECONDS = 1
local SETTLED_FARM_STATES = { Completed = true, Missed = true, Burned = true }
local SETTLED_FIELD_STATES = { Collected = true, Burned = true }

local world: Model
local gameConfig: any
local playerState: any
local machineService: any
local smokeService: any
local weatherService: any
local startTime = 0
local duration = 0
local over = false
local reports: { [Player]: any } = {}
local firstSaleAt: { [Player]: number } = {}
local bottlenecks = SeasonResults.newBottleneckLog()
local endReason = ""

local function now(): number
	return workspace:GetServerTimeNow()
end

local function elapsedNow(): number
	return now() - startTime
end

-- Fields and commitments as plain tables for SeasonResults, read from the world attributes
-- that FieldService and CommitmentService own.
local function gatherFields(): ({ SeasonResults.Field }, { SeasonResults.Commitment })
	local fields: { SeasonResults.Field } = {}
	local commitments: { SeasonResults.Commitment } = {}
	local records = smokeService:GetRecords()

	local own = gameConfig.Fields.FarmA
	local ownModel = world:FindFirstChild(own.ModelName, true)
	local ownState = if ownModel then ownModel:GetAttribute("State") else nil
	table.insert(fields, {
		name = own.DisplayName,
		bundles = own.Bundles,
		burnExposure = own.BurnExposure,
		resolved = typeof(ownState) == "string" and SETTLED_FIELD_STATES[ownState] == true,
		trustChange = if ownState == "Burned" then -own.BurnTrustLoss else 0,
	})

	for _, farmId in CommitmentDefinitions.FarmOrder do
		local definition = CommitmentDefinitions.Farms[farmId]
		local model = world:FindFirstChild(definition.ModelName, true)
		local rawState = if model then model:GetAttribute("State") else nil
		local state = if typeof(rawState) == "string" then rawState else "Available"
		-- A rejected farm burns at its deadline and then reads Burned; the record keeps why.
		for _, record in records do
			if record.field == definition.DisplayName and record.responsibility == "Rejected" then
				state = "Rejected"
			end
		end
		table.insert(fields, {
			name = definition.DisplayName,
			bundles = definition.Bundles,
			burnExposure = definition.BurnExposure,
			resolved = typeof(rawState) == "string" and SETTLED_FARM_STATES[rawState] == true,
			trustChange = 0,
		})
		table.insert(commitments, {
			name = definition.ShortName,
			state = state,
			trustChange = if state == "Completed"
				then definition.CompleteTrust
				elseif state == "Missed" then definition.MissTrust
				else 0,
		})
	end
	return fields, commitments
end

local function buildReport(player: Player): any
	local burns: { SeasonResults.Burn } = {}
	for _, record in smokeService:GetRecords() do
		table.insert(burns, {
			field = record.field,
			quantity = record.quantity,
			time = record.time - startTime,
			wind = record.wind,
			destination = record.destination,
			exposure = record.exposure,
			potential = record.potential,
			responsibility = record.responsibility,
		})
	end
	local fields, commitments = gatherFields()
	return SeasonResults.compute({
		ledger = playerState:GetLedger(player),
		endingCash = playerState:GetCredits(player),
		infrastructureValue = machineService:GetInfrastructureValue(player),
		infrastructureRate = SeasonDefinitions.Results.InfrastructureCreditRate,
		startingTrust = gameConfig.Player.StartingTrust,
		endingTrust = playerState:GetTrust(player),
		burns = burns,
		fields = fields,
		commitments = commitments,
		responsibilityText = CommitmentDefinitions.Responsibility,
		firstSaleAt = firstSaleAt[player],
		bottleneck = bottlenecks.first,
		endReason = endReason,
		disclaimer = SeasonDefinitions.Results.Disclaimer,
	})
end

local function endSeason(reason: string)
	if over then
		return
	end
	over = true
	endReason = reason
	for _, player in Players:GetPlayers() do
		reports[player] = buildReport(player)
	end
	local results = SeasonDefinitions.ResultsPhase
	world:SetAttribute("SeasonPhase", results.Id)
	world:SetAttribute("SeasonPhaseName", results.Name)
	world:SetAttribute("SeasonGoal", results.Goal)
	world:SetAttribute("SeasonEndReason", reason)
	world:SetAttribute("SeasonOver", true)
	machineService:NotifyAll("Season over. " .. reason .. " Your results are ready.")
end

-- Spec 12.5 soft failure: every field is settled and no straw is left to process.
local function factoryIsIdle(): boolean
	-- Rice growing or straw lying on any paddy keeps the season open.
	for _, paddy in CollectionService:GetTagged("Paddy") do
		if paddy:GetAttribute("CropActive") == true then
			return false
		end
	end
	local fields = gatherFields()
	for _, field in fields do
		if not field.resolved then
			return false
		end
	end
	if machineService:CountItems() > 0 then
		return false
	end
	for _, player in Players:GetPlayers() do
		local carried = player:GetAttribute("StrawBundles")
		if typeof(carried) == "number" and carried > 0 then
			return false
		end
	end
	return true
end

function SeasonService:Initialize(
	worldModel: Model,
	config: any,
	playerStateService: any,
	machines: any,
	smoke: any,
	weather: any
)
	world = worldModel
	gameConfig = config
	playerState = playerStateService
	machineService = machines
	smokeService = smoke
	weatherService = weather
	startTime = now()
	duration = config.Round.DurationSeconds

	world:SetAttribute("SeasonStartedAt", startTime)
	world:SetAttribute("SeasonEndsAt", startTime + duration)
	world:SetAttribute("SeasonDuration", duration)
	world:SetAttribute("SeasonOver", false)
	weatherService:Initialize(world, config, machines, startTime)

	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local resultsRemote = Instance.new("RemoteFunction")
	resultsRemote.Name = "GetSeasonResults"
	resultsRemote.OnServerInvoke = function(player: Player): any
		if not over then
			return nil
		end
		-- A player who joined after the end still gets a report of the shared district.
		if reports[player] == nil then
			reports[player] = buildReport(player)
		end
		return reports[player]
	end
	resultsRemote.Parent = remotes

	Players.PlayerRemoving:Connect(function(player)
		reports[player] = nil
		firstSaleAt[player] = nil
	end)

	-- Kind is rolled now; ForcedWeatherEvent can still override it until the forecast.
	local roll = Random.new():NextNumber()
	local forecastAt = SeasonClock.planWeather(SeasonDefinitions, duration, "Rain").forecastAt
	local stress = SeasonClock.findPhase(SeasonDefinitions, duration, "Stress")
	local stressStart = if stress then stress.startsAt else 0
	local idleSeconds = 0
	local lastPhase = ""

	task.spawn(function()
		while not over do
			local elapsed = elapsedNow()

			local phase = SeasonClock.phaseAt(SeasonDefinitions, duration, elapsed)
			if phase.id ~= lastPhase and phase.id ~= SeasonDefinitions.ResultsPhase.Id then
				lastPhase = phase.id
				world:SetAttribute("SeasonPhase", phase.id)
				world:SetAttribute("SeasonPhaseName", phase.name)
				world:SetAttribute("SeasonGoal", phase.goal)
				world:SetAttribute("SeasonPhaseEndsAt", startTime + phase.endsAt)
				if phase.index > 1 then
					machineService:NotifyAll(
						string.format("Season phase: %s. %s", phase.name, phase.goal)
					)
				end
			end

			if weatherService:GetPlan() == nil and elapsed >= forecastAt then
				local forced = world:GetAttribute("ForcedWeatherEvent")
				local kind = SeasonClock.pickEvent(
					SeasonDefinitions,
					roll,
					if typeof(forced) == "string" then forced else nil
				)
				weatherService:SetPlan(SeasonClock.planWeather(SeasonDefinitions, duration, kind))
			end
			weatherService:Update(elapsed)

			for _, player in Players:GetPlayers() do
				if
					firstSaleAt[player] == nil
					and player:GetAttribute("TutorialComplete") == true
				then
					firstSaleAt[player] = elapsed
				end
			end
			SeasonResults.trackBottlenecks(
				bottlenecks,
				machineService:GetProcessorStates(),
				TICK_SECONDS,
				elapsed,
				SeasonDefinitions.Results.BottleneckSeconds
			)

			if world:GetAttribute("EndSeasonNow") == true then
				endSeason("The season was ended early for a play test.")
				break
			end
			if elapsed >= duration then
				endSeason(string.format("The %d minute season is over.", math.floor(duration / 60)))
				break
			end
			if elapsed >= stressStart and factoryIsIdle() then
				if idleSeconds == 0 then
					machineService:NotifyAll(
						string.format(
							"Every field is settled and the factory is empty. The season closes in %d s.",
							SeasonDefinitions.SoftEnd.IdleSeconds
						)
					)
				end
				idleSeconds += TICK_SECONDS
				if idleSeconds >= SeasonDefinitions.SoftEnd.IdleSeconds then
					endSeason("Every field was settled and no straw was left to process.")
					break
				end
			else
				idleSeconds = 0
			end
			task.wait(TICK_SECONDS)
		end
	end)
end

return SeasonService
]]></ProtectedString>
						<string name="ScriptGuid">{216D96F4-8D8D-4A7E-B38D-701EEA5EA63C}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">SeasonService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f00008516</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX1F8788FA209445339DEBA85F29A05F25">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- Dresses the graybox district with the imported building models: the pellet buyer depot, the
-- village houses, and the school. Each graybox block stays as an invisible collision box and keeps
-- its label, so gameplay and exposure zones do not change. Missing art leaves the block as it was.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MachineArt = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MachineArt"))
local Houses = require(script.Parent:WaitForChild("Houses"))

local WorldArtService = {}

-- The pellet buyer is the district's big landmark, much larger than the graybox block.
local BUYER_SCALE = 2
-- Village houses read as real buildings next to the machines at this size.
local HOUSE_SCALE = 1.4
-- The graybox village overlapped Farm C, so it moves east: a row of houses at the back and a
-- school campus between them and the main road. Positions are ground centres.
local VILLAGE_CENTER = Vector3.new(220, 0, -35)
local VILLAGE_LAYOUT: { [string]: Vector3 } = {
	House_1 = Vector3.new(185, 0, -63),
	House_2 = Vector3.new(220, 0, -63),
	House_3 = Vector3.new(255, 0, -63),
	School = Vector3.new(220, 0, -12),
}
local CAMPUS_SIZE = Vector3.new(80, 10, 44)

local function dress(model: Instance?, artName: string, scale: number?)
	if model == nil or not model:IsA("Model") then
		return
	end
	local body = model:FindFirstChild("Body")
	if body == nil or not body:IsA("BasePart") or model:FindFirstChild("Art") then
		return
	end
	local art = MachineArt.Build(artName)
	if art == nil then
		return
	end
	if scale and scale ~= 1 then
		-- The art pivot is its bottom centre, so it grows upward and outward from the ground.
		art:ScaleTo(scale)
	end
	art:PivotTo(body.CFrame * CFrame.new(0, -body.Size.Y / 2, 0))
	art.Parent = model
	body.Transparency = 1
end

-- Grows the buyer's collision block before MachineService places its IN port and status board.
-- The west wall stays put, so the loading dock and any belts to it keep lining up.
function WorldArtService:EnlargeBuyer(world: Model)
	local buyer = world:FindFirstChild("PelletBuyer")
	local body = if buyer then buyer:FindFirstChild("Body") else nil
	if body == nil or not body:IsA("BasePart") or body:GetAttribute("Enlarged") then
		return
	end
	local oldSize = body.Size
	local westX = body.Position.X - oldSize.X / 2
	local groundY = body.Position.Y - oldSize.Y / 2
	local newSize = oldSize * BUYER_SCALE
	body.Size = newSize
	body.CFrame = CFrame.new(westX + newSize.X / 2, groundY + newSize.Y / 2, body.Position.Z)
	body:SetAttribute("Enlarged", true)
end

-- Moves and resizes the village's collision blocks before the landscape is planted, so trees and
-- tracks fit around the new layout. The exposure zone moves with the village, so smoke is still
-- judged against where people live.
function WorldArtService:PrepareVillage(world: Model)
	local village = world:FindFirstChild("Village")
	if village == nil or village:GetAttribute("Prepared") then
		return
	end
	village:SetAttribute("Prepared", true)
	for _, child in village:GetChildren() do
		local target = VILLAGE_LAYOUT[child.Name]
		if child.Name == "ExposureZone" and child:IsA("BasePart") then
			child.Position = Vector3.new(VILLAGE_CENTER.X, child.Position.Y, VILLAGE_CENTER.Z)
		elseif target then
			local body = child:FindFirstChild("Body")
			if body and body:IsA("BasePart") then
				if child.Name == "School" then
					-- The block now stands for the whole campus; the campus parts do the colliding.
					body.Size = CAMPUS_SIZE
					body.CanCollide = false
				else
					body.Size *= HOUSE_SCALE
				end
				body.CFrame = CFrame.new(target + Vector3.new(0, body.Size.Y / 2, 0))
			end
			-- Players can see a house is a house: the graybox name signs go.
			for _, descendant in child:GetDescendants() do
				if descendant:IsA("BillboardGui") and descendant.Name == "MapLabel" then
					descendant.Enabled = false
				end
			end
		end
	end
end

function WorldArtService:Initialize(world: Model)
	local buyer = world:FindFirstChild("PelletBuyer")
	dress(buyer, "BuyerDepot", BUYER_SCALE)
	-- The buyer's live status board already names it, so the old graybox sign would overlap it.
	local buyerSign = if buyer then buyer:FindFirstChild("MapLabel", true) else nil
	if buyerSign and buyerSign:IsA("BillboardGui") then
		buyerSign.Enabled = false
	end
	local village = world:FindFirstChild("Village")
	if village then
		for _, child in village:GetChildren() do
			if string.sub(child.Name, 1, 6) == "House_" then
				dress(child, "House", HOUSE_SCALE)
			elseif child.Name == "School" then
				local body = child:FindFirstChild("Body")
				if
					body
					and body:IsA("BasePart")
					and child:FindFirstChild("SchoolCampus") == nil
				then
					-- The gate faces the main road (+Z), so the campus turns around.
					local campus = Houses.SchoolCampus(
						CFrame.new(
							body.Position.X,
							body.Position.Y - body.Size.Y / 2,
							body.Position.Z
						) * CFrame.Angles(0, math.pi, 0),
						Random.new(7)
					)
					campus.Parent = child
					body.Transparency = 1
				end
			end
		end
	end
end

return WorldArtService
]]></ProtectedString>
						<string name="ScriptGuid">{E108971D-C21A-4B84-964E-D48EF60E5DC5}</string>
