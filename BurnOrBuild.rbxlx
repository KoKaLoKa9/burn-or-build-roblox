						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">FarmBoard</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f0001c204</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX54931838B5F64E0BABD48DC000135547">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- One rice paddy's crop cycle, shared by the player's own field (Farm A) and the paddy plots
-- players buy. Straw on the field must be cleared before planting, by hand or by fire. Then each
-- row is planted (seed cost), grows, and is harvested (grain credits), leaving a straw sheaf in
-- the lane beside it. Every batch of straw brings the burn or build choice back.
--
-- A field may start with straw and a clearing deadline (Farm A's first batch). When the deadline
-- passes with straw left, the field burns on its own.
--
-- PaddyField.new returns a handle so farm machines (the transplanter and the combine) can plant
-- and harvest the same rows on behalf of their owner. PaddyField.ForModel finds that handle.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local FarmBoard = require(script.Parent:WaitForChild("FarmBoard"))
local StrawSheaf = require(script.Parent:WaitForChild("StrawSheaf"))

local PaddyField = {}

-- Tag on every paddy model, so the season can tell when crops are still in play. Build mode and
-- farm machine placement also find paddies through it.
PaddyField.Tag = "Paddy"

local UPDATE_SECONDS = 0.5
local CHARRED = Color3.fromRGB(52, 45, 38)
local PREPARED = Color3.fromRGB(128, 104, 70)
local SEEDLING = Color3.fromRGB(160, 214, 96)
local GROWN = Color3.fromRGB(70, 142, 52)
local Colors = FarmBoard.Colors
-- Sheaves stand at varied depths in each lane, as a share of the row length.
local SHEAF_DEPTHS = { -0.31, 0.19, -0.09, 0.34, -0.22, 0.06, 0.28, -0.37 }

-- Planted rice fills most of its lane like a real paddy; bare and stubble rows stay narrow so
-- the straw sheaves have room in the lanes between them.
type Look = { width: number, height: number, color: Color3, material: Enum.Material }
local NARROW, WIDE = 2.2, 6.4
local EMPTY_LOOK: Look = {
	width = NARROW,
	height = 0.5,
	color = Color3.fromRGB(104, 80, 56),
	material = Enum.Material.Ground,
}
local STUBBLE_LOOK: Look = {
	width = NARROW,
	height = 1.2,
	color = Color3.fromRGB(198, 160, 82),
	material = Enum.Material.Grass,
}
local RIPE_LOOK: Look = {
	width = WIDE,
	height = 3.4,
	color = Color3.fromRGB(228, 188, 72),
	material = Enum.Material.Grass,
}

type Row = {
	index: number,
	part: BasePart,
	bottom: CFrame,
	stage: string, -- Stubble, Empty, Growing, Ripe
	plantedAt: number,
	-- Fixed when the row is planted, from the soil at that moment.
	growSeconds: number,
	grain: number,
	prompt: ProximityPrompt,
}

export type Options = {
	model: Model,
	title: string, -- board title, such as "Your field"
	displayName: string, -- name in burn records and notices
	strawArea: BasePart,
	burnPoint: BasePart,
	boardPart: BasePart,
	boardName: string,
	rows: { BasePart },
	-- Which end of the rows faces the path: 1 is the +Z end (default), -1 the -Z end.
	front: number?,
	planting: any, -- SeedCost, Soil levels, BurnClearSeconds
	burnExposure: number,
	burnTrustLoss: number,
	-- Only the owner may plant, harvest, and burn. No owner means anyone may.
	owner: Player?,
	-- Straw already lying on the field at the start, and when it must be cleared.
	startingSheaves: number?,
	deadlineAt: number?,
	-- Services the field reports to.
	world: Model,
	playerState: any,
	smokeService: any,
	gameConfig: any,
	notify: (player: Player?, message: string) -> (),
	-- Called when the field is clear of straw. `first` is true for the opening batch.
	onCleared: ((how: string, triggeringPlayer: Player?, first: boolean) -> ())?,
	onSheafCollected: ((first: boolean) -> ())?,
}

-- What a farm machine needs to know before it works a row.
export type Status = {
	empty: number,
	growing: number,
	ripe: number,
	sheaves: number,
	clearing: boolean,
}

export type Handle = {
	model: Model,
	strawArea: BasePart,
	owner: Player?,
	planting: any,
	-- Whether this player may farm the paddy (the owner, or anyone on an unowned field).
	CanUse: (player: Player) -> boolean,
	Status: () -> Status,
	-- Plants the first empty row or harvests the first ripe row for this player. Returns
	-- whether a row was worked and, if not, why. Nothing is told to the player, so a machine
	-- can call these every tick.
	PlantNext: (player: Player) -> (boolean, string),
	HarvestNext: (player: Player) -> (boolean, string),
	-- Lifts one straw sheaf off the field for a baler. Counts as collecting by hand, so a
	-- field the baler empties is a clean clear.
	TakeSheaf: () -> boolean,
}

local handles: { [Model]: Handle } = setmetatable({}, { __mode = "k" }) :: any

function PaddyField.ForModel(model: Instance): Handle?
	return if model:IsA("Model") then handles[model] else nil
end

local function now(): number
	return workspace:GetServerTimeNow()
end

-- "1 row", "3 rows", "1 sheaf", "4 sheaves".
local function count(amount: number, singular: string, plural: string?): string
	return string.format(
		"%d %s",
		amount,
		if amount == 1 then singular else plural or singular .. "s"
	)
end

local function formatClock(seconds: number): string
	local whole = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

function PaddyField.Prompt(
	parent: Instance,
	name: string,
	actionText: string,
	objectText: string,
	keyboardKey: Enum.KeyCode,
	holdDuration: number
): ProximityPrompt
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("ProximityPrompt") then
		existing:Destroy()
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.KeyboardKeyCode = keyboardKey
	prompt.HoldDuration = holdDuration
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

local function setLook(
	row: Row,
	width: number,
	height: number,
	color: Color3,
	material: Enum.Material
)
	row.part.Size = Vector3.new(width, height, row.part.Size.Z)
	row.part.CFrame = row.bottom * CFrame.new(0, height / 2, 0)
	row.part.Color = color
	row.part.Material = material
end

local function applyLook(row: Row, look: Look)
	setLook(row, look.width, look.height, look.color, look.material)
end

function PaddyField.new(options: Options): Handle
	local planting = options.planting
	local model = options.model
	local strawArea = options.strawArea
	local playerState = options.playerState
	local notify = options.notify

	local firstBatch = (options.startingSheaves or 0) > 0
	local deadlineAt = options.deadlineAt
	local clearing = false
	local batch = 0
	local sheaves: { Model } = {}
	local rows: { Row } = {}
	-- Soil health, an index into planting.Soil (1 is the worst). Fields start healthy.
	local soil = #planting.Soil
	local function soilLevel(): any
		return planting.Soil[soil]
	end
	local function soilNote(): string
		return if soil < #planting.Soil
			then string.format("  ·  Soil %s", string.lower(soilLevel().Name))
			else ""
	end
	model:SetAttribute("Soil", soilLevel().Name)
	-- Planting window: when the field last became clear. Rows planted late yield less.
	local clearedAt = 0
	-- Next-crop effects of how the field was cleared: ash after a burn, pests after a hand clear.
	local ash = false
	local pests = false
	local rowsPlanted = 0

	-- The share of full grain a row planted right now will give.
	local function yieldNow(): number
		local late = math.max(0, now() - clearedAt - planting.WindowSeconds)
		local factor = math.max(planting.MinYield, 1 - late / 60 * planting.LateLossPerMinute)
		if ash then
			factor *= 1 + planting.AshBonus
		end
		if pests then
			factor *= 1 - planting.PestLoss
		end
		return factor
	end

	-- Build mode reads the owner to tell whether a farm machine may be placed here.
	model:SetAttribute("OwnerUserId", if options.owner then options.owner.UserId else 0)
	CollectionService:AddTag(model, PaddyField.Tag)
	local oldSheaves = model:FindFirstChild("Sheaves")
	if oldSheaves then
		oldSheaves:Destroy()
	end
	local sheafFolder = Instance.new("Folder")
	sheafFolder.Name = "Sheaves"
	sheafFolder.Parent = model

	local burnPrompt = PaddyField.Prompt(
		options.burnPoint,
		"BurnPrompt",
		"Allow burning",
		"Immediate field clearing",
		Enum.KeyCode.H,
		2
	)
	local board = FarmBoard.Create(options.boardPart, options.boardName, options.title)

	local function canUse(player: Player): boolean
		local owner = options.owner
		return owner == nil or owner == player
	end

	local function ownerMessage(): string
		local owner = options.owner
		return string.format(
			"This paddy belongs to %s.",
			if owner then owner.DisplayName else "another player"
		)
	end

	local function allowed(player: Player): boolean
		if canUse(player) then
			return true
		end
		notify(player, ownerMessage())
		return false
	end

	-- Lanes sit halfway between neighbouring rows; depths vary so sheaves never line up.
	local function sheafGround(lane: number, pass: number): CFrame
		local laneCount = #rows - 1
		local left = rows[math.clamp(lane, 1, laneCount)]
		local right = rows[math.clamp(lane, 1, laneCount) + 1]
		local x = (left.bottom.Position.X + right.bottom.Position.X) / 2
		local depth = SHEAF_DEPTHS[(lane + pass * 3) % #SHEAF_DEPTHS + 1] * left.part.Size.Z
		local top = strawArea.Position.Y + strawArea.Size.Y / 2
		return CFrame.new(x, top, strawArea.Position.Z + depth)
	end

	local refreshPrompts: () -> ()

	local function refreshBoard()
		local raining = options.world:GetAttribute("WeatherActive") == "Rain"
		local growing, ripe, empty = 0, 0, 0
		local nextRipe = math.huge
		for _, row in rows do
			if row.stage == "Growing" then
				growing += 1
				nextRipe = math.min(nextRipe, row.plantedAt + row.growSeconds)
			elseif row.stage == "Ripe" then
				ripe += 1
			elseif row.stage == "Empty" then
				empty += 1
			end
		end

		if clearing then
			FarmBoard.Set(
				board,
				"BURNING",
				Colors.Red,
				"Straw burning",
				"Smoke is drifting downwind"
			)
		elseif #sheaves > 0 then
			FarmBoard.Set(
				board,
				"STRAW",
				Colors.Gold,
				if deadlineAt
					then string.format(
						"%s left  ·  %s",
						count(#sheaves, "sheaf", "sheaves"),
						formatClock(deadlineAt - now())
					)
					else count(#sheaves, "sheaf", "sheaves") .. " left",
				if raining
					then "Raining: straw stays wet"
					else "Burn (H): fast, plant on time  ·  Collect (E): keep the straw"
			)
		elseif ripe > 0 then
			FarmBoard.Set(
				board,
				"RIPE",
				Colors.Gold,
				count(ripe, "row") .. " ripe",
				"Harvest at the row ends for grain" .. soilNote()
			)
		elseif growing > 0 then
			FarmBoard.Set(
				board,
				"GROWING",
				Colors.Green,
				string.format(
					"%s growing  ·  ripe in %s",
					count(growing, "row"),
					formatClock(nextRipe - now())
				),
				(
					if empty > 0
						then count(empty, "row") .. " still empty"
						else "Harvest gives grain and new straw"
				) .. soilNote()
			)
		else
			local left = clearedAt + planting.WindowSeconds - now()
			FarmBoard.Set(
				board,
				"READY TO PLANT",
				Colors.Teal,
				if left > 0
					then string.format("Plant within %s for full grain", formatClock(left))
					else string.format("Late: %d%% grain", math.floor(yieldNow() * 100 + 0.5)),
				string.format("Plant at the row ends: %d credits a row", planting.SeedCost)
					.. soilNote()
			)
		end

		model:SetAttribute("RemainingBundles", #sheaves)
		-- The opening batch is judged by its own deadline, so it does not hold the season open.
		model:SetAttribute(
			"CropActive",
			not firstBatch and (growing > 0 or ripe > 0 or #sheaves > 0 or clearing)
		)
	end

	-- Straw is gone (picked up or burned): stubble rows turn back into empty, plantable rows.
	local function fieldCleared(how: string, triggeringPlayer: Player?)
		-- Cleared ground reads as a prepared, muddy paddy rather than a stubble field.
		strawArea.Color = PREPARED
		strawArea.Material = Enum.Material.Ground
		for _, row in rows do
			if row.stage == "Stubble" then
				row.stage = "Empty"
				applyLook(row, EMPTY_LOOK)
			end
		end
		-- Soil health: fire burns off organic matter and nitrogen; a clean clear lets it recover.
		local before = soil
		if how == "Burned" then
			soil = math.max(1, soil - 1)
		else
			soil = math.min(#planting.Soil, soil + 1)
		end
		model:SetAttribute("Soil", soilLevel().Name)
		if soil ~= before then
			local level = soilLevel()
			-- "Your rice field" reads as "your rice field" inside a sentence.
			local fieldName = string.gsub(options.displayName, "^Your ", "your ")
			local message = if how == "Burned"
				then string.format(
					"Burning damaged the soil on %s: it is now %s. Rice will take %d s to grow and pay %d credits a row. Clear straw by hand to restore it.",
					fieldName,
					string.lower(level.Name),
					level.GrowSeconds,
					level.GrainCredits
				)
				else string.format(
					"Clearing the straw by hand let the soil on %s recover: it is now %s.",
					fieldName,
					string.lower(level.Name)
				)
			local told: { Player } = if triggeringPlayer
				then { triggeringPlayer }
				elseif options.owner then { options.owner }
				else Players:GetPlayers()
			for _, player in told do
				notify(player, message)
			end
		end
		clearedAt = now()
		ash = how == "Burned"
		pests = how == "Collected" and math.random() < planting.PestChance
		if ash or pests then
			local told: { Player } = if triggeringPlayer
				then { triggeringPlayer }
				elseif options.owner then { options.owner }
				else Players:GetPlayers()
			for _, player in told do
				notify(
					player,
					if ash
						then string.format(
							"The ash feeds the next crop: +%d%% grain, this harvest only.",
							math.floor(planting.AshBonus * 100 + 0.5)
						)
						else string.format(
							"Stem borers survived in the stubble: the next crop gives %d%% less grain. Fire would have killed them.",
							math.floor(planting.PestLoss * 100 + 0.5)
						)
				)
			end
		end
		local first = firstBatch
		firstBatch = false
		deadlineAt = nil
		if options.onCleared then
			options.onCleared(how, triggeringPlayer, first)
		end
		refreshPrompts()
		refreshBoard()
	end

	local function collectSheaf(player: Player, sheaf: Model)
		local position = table.find(sheaves, sheaf)
		if clearing or position == nil then
			return
		end
		table.remove(sheaves, position)
		sheaf:Destroy()
		playerState:AddStraw(player, 1)
		if options.onSheafCollected then
			options.onSheafCollected(firstBatch)
		end
		if #sheaves == 0 then
			fieldCleared("Collected", nil)
		else
			refreshPrompts()
			refreshBoard()
		end
	end

	local function addSheaf(ground: CFrame, seed: number)
		local sheaf, bundle = StrawSheaf.Build(ground, seed)
		local prompt = PaddyField.Prompt(
			bundle,
			"PickUpPrompt",
			"Pick up",
			"Rice straw sheaf",
			Enum.KeyCode.E,
			0.3
		)
		prompt.MaxActivationDistance = 8
		prompt.Triggered:Connect(function(player)
			collectSheaf(player, sheaf)
		end)
		sheaf.Parent = sheafFolder
		table.insert(sheaves, sheaf)
	end

	local function burn(triggeringPlayer: Player?)
		if clearing or #sheaves == 0 then
			return
		end
		clearing = true
		local burnedBundles = #sheaves
		for _, sheaf in sheaves do
			StrawSheaf.Char(sheaf)
		end
		for _, row in rows do
			if row.stage == "Stubble" then
				row.part.Color = CHARRED
			end
		end

		-- The person who lit it loses trust. A deadline burn on an unowned field costs everyone.
		local blamed: { Player } = if triggeringPlayer
			then { triggeringPlayer }
			elseif options.owner then { options.owner }
			else Players:GetPlayers()
		for _, player in blamed do
			playerState:AdjustTrust(player, -options.burnTrustLoss)
		end
		if triggeringPlayer then
			-- Villagers and the cooperative react to how often you burn (VillageService).
			local burns = triggeringPlayer:GetAttribute("Burns")
			triggeringPlayer:SetAttribute(
				"Burns",
				(if typeof(burns) == "number" then burns else 0) + 1
			)
		end
		local burnRules = options.gameConfig.Burn
		if triggeringPlayer and options.world:GetAttribute("BurnBan") == true then
			-- Smog season: open burning is banned, like the burn bans in northern Thailand.
			playerState:AdjustCredits(triggeringPlayer, -burnRules.FineCredits, "Fine")
			notify(
				triggeringPlayer,
				string.format(
					"Burn ban in force: fined %d credits for open burning.",
					burnRules.FineCredits
				)
			)
		end
		-- Fire jumps to farm machines standing beside the field and stops them for a while.
		local production = options.world:FindFirstChild("Production")
		if production then
			local area = strawArea.Size / 2
				+ Vector3.new(burnRules.ScorchRange, 0, burnRules.ScorchRange)
			for _, machine in production:GetChildren() do
				if machine:IsA("Model") and machine:GetAttribute("FarmMachine") == true then
					local offset = strawArea.CFrame:PointToObjectSpace(machine:GetPivot().Position)
					if math.abs(offset.X) <= area.X and math.abs(offset.Z) <= area.Z then
						machine:SetAttribute("ScorchedUntil", now() + burnRules.ScorchSeconds)
					end
				end
			end
		end
		options.smokeService:BurnField(
			options.world,
			options.burnPoint,
			options.burnExposure,
			playerState,
			options.gameConfig,
			{
				field = options.displayName,
				quantity = burnedBundles,
				responsibility = if triggeringPlayer
					then "PlayerAuthorized"
					else "PlayerFarmDeadline",
			}
		)
		refreshPrompts()
		refreshBoard()

		task.delay(planting.BurnClearSeconds, function()
			for _, sheaf in sheaves do
				sheaf:Destroy()
			end
			table.clear(sheaves)
			clearing = false
			fieldCleared("Burned", triggeringPlayer)
		end)
	end

	-- Plants and harvests return whether the row was worked and, if not, why. The row prompts
	-- tell the player; farm machines show the reason on their own board instead.
	local function plant(player: Player, row: Row): (boolean, string)
		if row.stage ~= "Empty" then
			return false, "This row is not ready to plant."
		end
		if not canUse(player) then
			return false, ownerMessage()
		end
		if #sheaves > 0 or clearing then
			return false, "Clear the straw off the field before you plant."
		end
		if playerState:GetCredits(player) < planting.SeedCost then
			return false, string.format("Seed for a row costs %d credits.", planting.SeedCost)
		end
		playerState:AdjustCredits(player, -planting.SeedCost, "Rice")
		row.stage = "Growing"
		row.plantedAt = now()
		row.growSeconds = soilLevel().GrowSeconds
		row.grain = math.max(1, math.floor(soilLevel().GrainCredits * yieldNow() + 0.5))
		rowsPlanted += 1
		model:SetAttribute("RowsPlanted", rowsPlanted)
		setLook(row, WIDE, 1, SEEDLING, Enum.Material.LeafyGrass)
		refreshPrompts()
		refreshBoard()
		return true, ""
	end

	local function harvest(player: Player, row: Row): (boolean, string)
		if row.stage ~= "Ripe" then
			return false, "This row is not ripe yet."
		end
		if not canUse(player) then
			return false, ownerMessage()
		end
		row.stage = "Stubble"
		applyLook(row, STUBBLE_LOOK)
		playerState:AdjustCredits(player, row.grain, "Rice")
		-- Each row leaves one sheaf in the lane beside it; later batches shift the depth.
		local lane = math.min(row.index, #rows - 1)
		local pass = batch * 2 + (if row.index > #rows - 1 then 1 else 0)
		addSheaf(sheafGround(lane, pass), row.index + batch * 17)
		local cropLeft = false
		for _, other in rows do
			if other.stage == "Ripe" or other.stage == "Growing" then
				cropLeft = true
			end
		end
		if not cropLeft then
			batch += 1
		end
		refreshPrompts()
		refreshBoard()
		return true, ""
	end

	refreshPrompts = function()
		burnPrompt.Enabled = #sheaves > 0 and not clearing
		for _, row in rows do
			if row.stage == "Ripe" then
				row.prompt.ActionText = "Harvest rice"
				row.prompt.Enabled = true
			elseif row.stage == "Empty" then
				row.prompt.ActionText = string.format("Plant rice (%d credits)", planting.SeedCost)
				row.prompt.Enabled = #sheaves == 0 and not clearing
			else
				row.prompt.Enabled = false
			end
		end
		for _, sheaf in sheaves do
			local prompt = sheaf:FindFirstChild("PickUpPrompt", true)
			if prompt and prompt:IsA("ProximityPrompt") then
				prompt.Enabled = not clearing
			end
		end
	end

	-- Rows run north to south, left to right. Each gets a prompt at its south end, so the
	-- player plants and harvests by walking along the front of the field.
	local rowParts = table.clone(options.rows)
	table.sort(rowParts, function(a, b)
		return a.Position.X < b.Position.X
	end)
	local startStage = if firstBatch then "Stubble" else "Empty"
	for index, part in rowParts do
		part.CanCollide = false
		local bottom = part.CFrame * CFrame.new(0, -part.Size.Y / 2, 0)
		local anchor = Instance.new("Attachment")
		anchor.Name = "RowEnd"
		anchor.Position = Vector3.new(0, 0, (options.front or 1) * (part.Size.Z / 2 - 3))
		anchor.Parent = part
		local prompt = PaddyField.Prompt(
			anchor,
			"RowPrompt",
			"Plant rice",
			"Rice row " .. index,
			Enum.KeyCode.E,
			0.6
		)
		prompt.MaxActivationDistance = 9
		local row: Row = {
			index = index,
			part = part,
			bottom = bottom,
			stage = startStage,
			plantedAt = 0,
			growSeconds = 0,
			grain = 0,
			prompt = prompt,
		}
		applyLook(row, if firstBatch then STUBBLE_LOOK else EMPTY_LOOK)
		prompt.Triggered:Connect(function(player)
			if row.stage == "Ripe" then
				local grain = row.grain
				local ok, reason = harvest(player, row)
				notify(
					player,
					if ok
						then string.format(
							"Harvested a row: +%d credits of grain. Its straw is on the field.",
							grain
						)
						else reason
				)
			else
				local ok, reason = plant(player, row)
				if not ok then
					notify(player, reason)
				end
			end
		end)
		table.insert(rows, row)
	end
	if not firstBatch then
		strawArea.Color = PREPARED
		strawArea.Material = Enum.Material.Ground
	end

	-- The opening straw keeps Farm A's original layout (spec 2.3: manual collection first).
	for index = 1, options.startingSheaves or 0 do
		addSheaf(StrawSheaf.GroundFor(strawArea, index), index)
	end
	batch = 1

	burnPrompt.Triggered:Connect(function(player)
		if allowed(player) then
			burn(player)
		end
	end)
	refreshPrompts()
	refreshBoard()

	task.spawn(function()
		while model.Parent do
			local current = now()
			for _, row in rows do
				if row.stage == "Growing" then
					local grown = math.clamp((current - row.plantedAt) / row.growSeconds, 0, 1)
					if grown >= 1 then
						row.stage = "Ripe"
						applyLook(row, RIPE_LOOK)
						refreshPrompts()
					else
						setLook(
							row,
							WIDE,
							1 + grown * 2.2,
							SEEDLING:Lerp(GROWN, grown),
							Enum.Material.LeafyGrass
						)
					end
				end
			end
			if deadlineAt and not clearing and #sheaves > 0 and current >= deadlineAt then
				burn(nil)
			end
			refreshBoard()
			task.wait(UPDATE_SECONDS)
		end
	end)

	local function firstRow(stage: string): Row?
		for _, row in rows do
			if row.stage == stage then
				return row
			end
		end
		return nil
	end

	local handle: Handle = {
		model = model,
		strawArea = strawArea,
		owner = options.owner,
		planting = planting,
		CanUse = canUse,
		Status = function(): Status
			local status: Status = {
				empty = 0,
				growing = 0,
				ripe = 0,
				sheaves = #sheaves,
				clearing = clearing,
			}
			for _, row in rows do
				if row.stage == "Empty" then
					status.empty += 1
				elseif row.stage == "Growing" then
					status.growing += 1
				elseif row.stage == "Ripe" then
					status.ripe += 1
				end
			end
			return status
		end,
		PlantNext = function(player: Player): (boolean, string)
			local row = firstRow("Empty")
			if row == nil then
				return false, "No empty rows."
			end
			return plant(player, row)
		end,
		HarvestNext = function(player: Player): (boolean, string)
			local row = firstRow("Ripe")
			if row == nil then
				return false, "No ripe rows."
			end
			return harvest(player, row)
		end,
		TakeSheaf = function(): boolean
			if clearing or #sheaves == 0 then
				return false
			end
			local sheaf = table.remove(sheaves) :: Model
			sheaf:Destroy()
			if options.onSheafCollected then
				options.onSheafCollected(firstBatch)
			end
			if #sheaves == 0 then
				fieldCleared("Collected", nil)
			else
				refreshPrompts()
				refreshBoard()
			end
			return true
		end,
	}
	handles[model] = handle
	return handle
end

return PaddyField
]]></ProtectedString>
						<string name="ScriptGuid">{0C92C3E4-B278-4AF4-9DFD-298086037C46}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">PaddyField</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f00026a03</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX11B7859140B04A089549FE8F2414E1A9">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- Paddy plots the player can buy (Week 5). Each lot starts as staked-out grass with a FOR SALE
-- board. Buying it turns the lot into a small paddy that runs the same cycle as the player's
-- own field through PaddyField: plant, grow, harvest for grain, and clear the straw by hand or
-- by fire. Only the buyer may farm their plot; anyone may carry its straw away.

local Flora = require(script.Parent:WaitForChild("Flora"))
local FarmBoard = require(script.Parent:WaitForChild("FarmBoard"))
local PaddyField = require(script.Parent:WaitForChild("PaddyField"))

local PlotService = {}

local ROW_SPACING = 9
local STAKE = Color3.fromRGB(128, 100, 70)

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material
): Part
	local item = Instance.new("Part")
	item.Name = name
	item.Size = size
	item.CFrame = cframe
	item.Color = color
	item.Material = material
	item.Anchored = true
	item.TopSurface = Enum.SurfaceType.Smooth
	item.BottomSurface = Enum.SurfaceType.Smooth
	item.Parent = parent
	return item
end

function PlotService:Initialize(
	world: Model,
	playerState: any,
	smokeService: any,
	gameConfig: any,
	machineService: any
)
	local config = gameConfig.Plots
	local planting = gameConfig.Fields.FarmA.Planting
	local oldFolder = world:FindFirstChild("Plots")
	if oldFolder then
		oldFolder:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Plots"
	folder.Parent = world

	local function notify(player: Player?, message: string)
		if player then
			machineService:Notify(player, message)
		end
	end

	for index, lot in config.Lots do
		local model = Instance.new("Model")
		model.Name = "Plot_" .. index
		model:SetAttribute("DisplayName", lot.Name)
		model:SetAttribute("OwnerUserId", 0)
		model.Parent = folder

		local width, depth, front = config.Width, config.Depth, lot.Front
		local center = CFrame.new(lot.X, 0, lot.Z)
		local frontZ = front * (depth / 2 + 6)

		-- Corner stakes mark the lot while it is for sale.
		local stakes = Instance.new("Model")
		stakes.Name = "Stakes"
		stakes.Parent = model
		for _, corner in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
			local stake = part(
				stakes,
				"Stake",
				Vector3.new(0.6, 3, 0.6),
				center * CFrame.new(corner[1] * width / 2, 1.5, corner[2] * depth / 2),
				STAKE,
				Enum.Material.Wood
			)
			stake.CanCollide = false
		end

		local sign = part(
			model,
			"Sign",
			Vector3.new(0.8, 5, 0.8),
			center * CFrame.new(-width / 2 + 6, 2.5, frontZ),
			STAKE,
			Enum.Material.Wood
		)
		local board = FarmBoard.Create(sign, "PlotBoard", lot.Name)
		FarmBoard.Set(
			board,
			"FOR SALE",
			FarmBoard.Colors.Teal,
			string.format("%d credits", config.Price),
			string.format("Hold E to buy: a paddy with %d rows", config.Rows)
		)
		local buyPrompt = PaddyField.Prompt(
			sign,
			"BuyPrompt",
			string.format("Buy plot (%d credits)", config.Price),
			lot.Name,
			Enum.KeyCode.E,
			1
		)

		local function build(owner: Player)
			stakes:Destroy()
			local strawArea = part(
				model,
				"StrawArea",
				Vector3.new(width, 1, depth),
				center * CFrame.new(0, 0.5, 0),
				Color3.fromRGB(128, 104, 70),
				Enum.Material.Ground
			)
			local rows: { BasePart } = {}
			for row = 1, config.Rows do
				local x = (row - (config.Rows + 1) / 2) * ROW_SPACING
				local rice = part(
					model,
					"RiceRow",
					Vector3.new(2.2, 0.5, depth - 8),
					center * CFrame.new(x, 1.05, 0),
					Color3.fromRGB(104, 80, 56),
					Enum.Material.Ground
				)
				rice.CanCollide = false
				table.insert(rows, rice)
			end
			local burnPoint = part(
				model,
				"BurnPoint",
				Vector3.new(6, 0.4, 6),
				center * CFrame.new(-width / 2 + 18, 0.2, frontZ),
				Color3.fromRGB(150, 80, 50),
				Enum.Material.Slate
			)
			burnPoint.CanCollide = false

			-- Bunds on three sides; the front stays open onto the path.
			local bunds = Instance.new("Model")
			bunds.Name = "Bunds"
			bunds.Parent = model
			local backZ = -front * depth / 2
			Flora.Bund(bunds, center * CFrame.new(0, 0, backZ), width + 2.2)
			Flora.Bund(
				bunds,
				center * CFrame.new(-width / 2, 0, 0) * CFrame.Angles(0, math.rad(90), 0),
				depth
			)
			Flora.Bund(
				bunds,
				center * CFrame.new(width / 2, 0, 0) * CFrame.Angles(0, math.rad(90), 0),
				depth
			)

			PaddyField.new({
				model = model,
				title = lot.Name,
				displayName = string.format("%s's %s", owner.DisplayName, string.lower(lot.Name)),
				strawArea = strawArea,
				burnPoint = burnPoint,
				boardPart = sign,
				boardName = "PlotBoard",
				rows = rows,
				front = front,
				planting = planting,
				burnExposure = gameConfig.Fields.FarmA.BurnExposure,
				burnTrustLoss = gameConfig.Fields.FarmA.BurnTrustLoss,
				owner = owner,
				world = world,
				playerState = playerState,
				smokeService = smokeService,
				gameConfig = gameConfig,
				notify = notify,
			})
		end

		buyPrompt.Triggered:Connect(function(player)
			if model:GetAttribute("OwnerUserId") ~= 0 then
				return
			end
			if playerState:GetCredits(player) < config.Price then
				notify(player, string.format("A paddy plot costs %d credits.", config.Price))
				return
			end
			playerState:AdjustCredits(player, -config.Price, "Construction")
			model:SetAttribute("OwnerUserId", player.UserId)
			buyPrompt:Destroy()
			build(player)
			notify(
				player,
				string.format("You bought %s. Plant rice at the row ends.", string.lower(lot.Name))
			)
		end)
	end
end

return PlotService
]]></ProtectedString>
						<string name="ScriptGuid">{0CAA0E38-4229-44CB-844A-FFC9D32EC2C6}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">PlotService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f00026a05</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXD02BF83E1EF04BD6A8CAB8C881E703B8">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- Farm machines, the first automation tier for rice farming (Week 5). Players plant and harvest
-- by hand first; a transplanter placed beside a paddy then plants its empty rows on its own, and
-- a combine harvester harvests its ripe rows. Both work through the same PaddyField rows as the
-- hand prompts, so the owner pays the normal seed cost and earns the normal grain, and harvested
-- rows still leave straw on the field. A transplanter waits until that straw is cleared, so the
-- burn or build choice stays with the player.
--
-- Week 6 adds the straw baler: it lifts the sheaves off its paddy into bales stacked beside it,
-- which counts as a clean clear (good for the soil). Anyone may take the baled straw with E and
-- carry it to the collection point.

local RunService = game:GetService("RunService")

local PaddyField = require(script.Parent:WaitForChild("PaddyField"))

local FarmMachineService = {}

local TICK_SECONDS = 0.25

type Worker = {
	record: any,
	progress: number,
	state: string, -- Working, Waiting, Blocked, Paused
	detail: string,
	rowsWorked: number,
	-- Balers only: bundles of straw waiting to be taken, and the bale stack that shows them.
	stored: number,
	stack: Model?,
}

local STATE_COLORS: { [string]: string } = {
	Working = "#68D88E",
	Waiting = "#F6BE48",
	Blocked = "#F06246",
	Paused = "#92A49D",
}

local workers: { [number]: Worker } = {}
local playerState: any
local machineServiceRef: any

local function set(worker: Worker, state: string, detail: string)
	worker.state, worker.detail = state, detail
	if state ~= "Working" then
		worker.progress = 0
	end
end

-- Decides whether the machine can work its paddy right now and, if not, why. Returns the
-- PaddyField handle to work on when it can.
local function check(worker: Worker): PaddyField.Handle?
	local record = worker.record
	local definition = record.node.definition
	local owner: Player? = record.owner
	local paddy: Model? = record.paddy
	local field = if paddy and paddy.Parent then PaddyField.ForModel(paddy) else nil
	if field == nil then
		set(worker, "Blocked", "No paddy beside this machine")
		return nil
	end
	if owner == nil or owner.Parent == nil then
		set(worker, "Paused", "Owner has left")
		return nil
	end
	if record.node.paused then
		set(worker, "Paused", "Paused")
		return nil
	end
	local scorched = record.model:GetAttribute("ScorchedUntil")
	if typeof(scorched) == "number" and workspace:GetServerTimeNow() < scorched then
		set(worker, "Blocked", "Scorched by the field fire")
		return nil
	end
	if not field.CanUse(owner) then
		set(worker, "Blocked", "This paddy belongs to another player")
		return nil
	end

	local status = field.Status()
	if definition.FarmAction == "Bale" then
		if status.clearing then
			set(worker, "Waiting", "Straw is burning")
		elseif worker.stored >= definition.Capacity then
			set(worker, "Blocked", "Full: take the straw with E")
		elseif status.sheaves == 0 then
			set(worker, "Waiting", "No straw on the field")
		else
			set(worker, "Working", string.format("Baling, %d sheaves left", status.sheaves))
			return field
		end
		return nil
	end
	if definition.FarmAction == "Plant" then
		if status.clearing then
			set(worker, "Waiting", "Straw is burning")
		elseif status.sheaves > 0 then
			set(worker, "Waiting", "Clear the straw first")
		elseif status.empty == 0 then
			set(worker, "Waiting", "Every row is planted")
		elseif playerState:GetCredits(owner) < field.planting.SeedCost then
			set(
				worker,
				"Blocked",
				string.format("Needs %d credits for seed", field.planting.SeedCost)
			)
		else
			set(worker, "Working", string.format("Planting, %d rows to go", status.empty))
			return field
		end
	else
		if status.ripe > 0 then
			set(worker, "Working", string.format("Harvesting, %d rows ripe", status.ripe))
			return field
		end
		set(
			worker,
			"Waiting",
			if status.growing > 0 then "Rice is growing" else "No crop to harvest"
		)
	end
	return nil
end

-- Straw bales stacked beside the baler, one bale for every two bundles it holds.
local function refreshStack(worker: Worker)
	local stack = worker.stack
	local body = worker.record.model.PrimaryPart
	if stack == nil or body == nil then
		return
	end
	local bales = math.ceil(worker.stored / 2)
	local current = #stack:GetChildren()
	for index = current + 1, bales do
		local bale = Instance.new("Part")
		bale.Name = "Bale"
		bale.Size = Vector3.new(2.6, 1.6, 1.8)
		local column = (index - 1) % 3
		local layer = (index - 1) // 3
		bale.CFrame = body.CFrame
			* CFrame.new(
				-body.Size.X / 2 - 2,
				-body.Size.Y / 2 + 0.8 + layer * 1.6,
				(column - 1) * 2
			)
		bale.Color = Color3.fromRGB(226, 185, 83)
		bale.Material = Enum.Material.Grass
		bale.Anchored = true
		bale.CanCollide = false
		bale.CanQuery = false
		bale.Parent = stack
	end
	for index = current, bales + 1, -1 do
		local bale = stack:GetChildren()[index]
		if bale then
			bale:Destroy()
		end
	end
end

local function step(worker: Worker, dt: number)
	local field = check(worker)
	if field == nil then
		return
	end
	local definition = worker.record.node.definition
	worker.progress += dt
	if worker.progress < definition.WorkSeconds then
		return
	end
	worker.progress = 0
	if definition.FarmAction == "Bale" then
		if field.TakeSheaf() then
			worker.stored += 1
			worker.rowsWorked += 1
			refreshStack(worker)
		end
		return
	end
	local owner = worker.record.owner :: Player
	local ok, reason
	if definition.FarmAction == "Plant" then
		ok, reason = field.PlantNext(owner)
	else
		ok, reason = field.HarvestNext(owner)
	end
	if ok then
		worker.rowsWorked += 1
	else
		set(worker, "Blocked", (string.gsub(reason, "%.$", "")))
	end
end

local function describe(record: any): string
	local worker = workers[record.node.id]
	local definition = record.node.definition
	if worker == nil then
		return definition.DisplayName
	end
	local progress = ""
	if worker.state == "Working" then
		local share = math.clamp(worker.progress / definition.WorkSeconds, 0, 1)
		local filled = math.floor(share * 5 + 0.5)
		progress = " [" .. string.rep("#", filled) .. string.rep(".", 5 - filled) .. "]"
	end
	local tally = if definition.FarmAction == "Bale"
		then string.format("Baled straw: %d/%d", worker.stored, definition.Capacity)
		elseif definition.FarmAction == "Plant" then string.format(
			"Rows planted: %d",
			worker.rowsWorked
		)
		else string.format("Rows harvested: %d", worker.rowsWorked)
	return string.format(
		'%s\n<font color="%s">%s</font>%s\n%s',
		definition.DisplayName,
		STATE_COLORS[worker.state] or "#F0EEE4",
		worker.detail,
		progress,
		tally
	)
end

function FarmMachineService:Initialize(machineService: any, playerStateService: any)
	playerState = playerStateService
	machineServiceRef = machineService

	machineService:RegisterKindHandler("Farm", {
		onPlaced = function(record: any)
			local worker: Worker = {
				record = record,
				progress = 0,
				state = "Waiting",
				detail = "Starting",
				rowsWorked = 0,
				stored = 0,
				stack = nil,
			}
			workers[record.node.id] = worker
			-- A field fire looks for this to scorch the machines standing beside it.
			record.model:SetAttribute("FarmMachine", true)
			local body = record.model.PrimaryPart
			if record.node.definition.FarmAction == "Bale" and body then
				local stack = Instance.new("Model")
				stack.Name = "Bales"
				stack.Parent = record.model
				worker.stack = stack
				local take = Instance.new("ProximityPrompt")
				take.Name = "TakePrompt"
				take.ActionText = "Take baled straw"
				take.ObjectText = record.node.definition.DisplayName
				take.KeyboardKeyCode = Enum.KeyCode.E
				take.MaxActivationDistance = 16
				take.RequiresLineOfSight = false
				take.UIOffset = Vector2.new(0, 40)
				take.Parent = body
				local pause = body:FindFirstChild("PausePrompt")
				if pause and pause:IsA("ProximityPrompt") then
					pause.UIOffset = Vector2.new(0, -40)
				end
				take.Triggered:Connect(function(player)
					if worker.stored <= 0 then
						return
					end
					playerState:AddStraw(player, worker.stored)
					machineServiceRef:Notify(
						player,
						string.format(
							"Took %d bundles of baled straw. Carry it to the collection point.",
							worker.stored
						)
					)
					worker.stored = 0
					refreshStack(worker)
				end)
			end
			check(worker)
		end,
		onRemoved = function(record: any)
			workers[record.node.id] = nil
		end,
		describe = describe,
	})

	local accumulated = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulated += dt
		if accumulated < TICK_SECONDS then
			return
		end
		local elapsed = accumulated
		accumulated = 0
		for _, worker in workers do
			step(worker, elapsed)
		end
	end)
end

return FarmMachineService
]]></ProtectedString>
						<string name="ScriptGuid">{8F216A82-81B4-4588-A2B1-39258BC23224}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">FarmMachineService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f0002e8af</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXC59E75A83F33463CBDE1F872B3A26C2A">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- Week 6 research. A player builds one cooperative office and hires up to three engineers there.
-- Engineers earn research points over time and draw a small wage. The player picks one project at
-- a time in the research panel (Research.client); when the points cover its cost, the machines
-- that name it in MachineDefinitions unlock. Hiring is cheaper when farmers trust the
-- cooperative, so keeping promises pays off in research too.
--
-- Player attributes the client reads: Engineers, ResearchPoints, ResearchProject (an id or ""),
-- and Research_<Id> = true for every finished project.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ResearchDefinitions = require(Shared:WaitForChild("ResearchDefinitions"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))

local ResearchService = {}

local TICK_SECONDS = 0.5

local playerState: any
local machineService: any
-- Each player's office record, while they have one.
local offices: { [Player]: any } = {}
local wageTimers: { [Player]: number } = {}

local function readNumber(player: Player, attribute: string): number
	local value = player:GetAttribute(attribute)
	return if typeof(value) == "number" then value else 0
end

local function project(player: Player): string
	local value = player:GetAttribute("ResearchProject")
	return if typeof(value) == "string" then value else ""
end

local function isDone(player: Player, projectId: string): boolean
	return player:GetAttribute("Research_" .. projectId) == true
end

function ResearchService:HireFee(player: Player): number
	local trust = math.clamp(playerState:GetTrust(player), 0, 100)
	return math.floor(ResearchDefinitions.BaseHireFee * (1.5 - trust / 100) + 0.5)
end

local function notify(player: Player, message: string)
	machineService:Notify(player, message)
end

local function startResearch(player: Player, projectId: unknown)
	if typeof(projectId) ~= "string" then
		return
	end
	local definition = ResearchDefinitions.Projects[projectId]
	if definition == nil then
		return
	end
	if isDone(player, projectId) then
		notify(player, definition.DisplayName .. " is already researched.")
		return
	end
	if definition.Requires and not isDone(player, definition.Requires) then
		local needed = ResearchDefinitions.Projects[definition.Requires]
		notify(player, string.format("Research %s first.", string.lower(needed.DisplayName)))
		return
	end
	player:SetAttribute("ResearchProject", projectId)
	notify(
		player,
		if readNumber(player, "Engineers") > 0
			then string.format("Researching %s.", string.lower(definition.DisplayName))
			else string.format(
				"Researching %s. Hire an engineer at the office to earn points.",
				string.lower(definition.DisplayName)
			)
	)
end

local function hire(player: Player)
	if offices[player] == nil then
		notify(player, "Build a cooperative office first.")
		return
	end
	local engineers = readNumber(player, "Engineers")
	if engineers >= ResearchDefinitions.MaxEngineers then
		notify(
			player,
			string.format("The office has room for %d engineers.", ResearchDefinitions.MaxEngineers)
		)
		return
	end
	local fee = ResearchService:HireFee(player)
	if playerState:GetCredits(player) < fee then
		notify(player, string.format("Hiring an engineer costs %d credits.", fee))
		return
	end
	playerState:AdjustCredits(player, -fee, "Research")
	player:SetAttribute("Engineers", engineers + 1)
	notify(
		player,
		string.format(
			"Engineer hired for %d credits. Higher farmer trust makes the next one cheaper.",
			fee
		)
	)
end

-- Points come in, wages go out, and a project finishes once its points are covered.
local function tick(dt: number)
	for _, player in Players:GetPlayers() do
		local engineers = readNumber(player, "Engineers")
		if engineers <= 0 then
			continue
		end
		local world = workspace:FindFirstChild("BurnOrBuildWorld")
		local smoggy = world ~= nil and world:GetAttribute("SmogActive") == true
		local rate = if smoggy then GameConfig.Smog.ResearchRate else 1
		local points = readNumber(player, "ResearchPoints")
			+ engineers * rate * dt / ResearchDefinitions.SecondsPerPoint
		local active = project(player)
		local definition = ResearchDefinitions.Projects[active]
		if definition and points >= definition.Points then
			points -= definition.Points
			player:SetAttribute("Research_" .. active, true)
			player:SetAttribute("ResearchProject", "")
			notify(
				player,
				string.format(
					"Research complete: %s. Find it in your inventory (B).",
					definition.DisplayName
				)
			)
		end
		player:SetAttribute("ResearchPoints", points)

		local waited = (wageTimers[player] or 0) + dt
		if waited >= ResearchDefinitions.WageIntervalSeconds then
			waited -= ResearchDefinitions.WageIntervalSeconds
			playerState:AdjustCredits(
				player,
				-ResearchDefinitions.WagePerInterval * engineers,
				"Research"
			)
		end
		wageTimers[player] = waited
	end
end

local function describe(record: any): string
	local owner: Player? = record.owner
	if owner == nil then
		return "Cooperative office"
	end
	local engineers = readNumber(owner, "Engineers")
	local active = project(owner)
	local definition = ResearchDefinitions.Projects[active]
	local status = if definition
		then string.format(
			"Researching %s: %d/%d",
			definition.DisplayName,
			math.floor(math.min(readNumber(owner, "ResearchPoints"), definition.Points)),
			definition.Points
		)
		elseif engineers > 0 then "Pick a project: [E] Research"
		else "Hire an engineer: [T]"
	return string.format(
		'Cooperative office\n%d/%d engineers\n<font color="#F6BE48">%s</font>',
		engineers,
		ResearchDefinitions.MaxEngineers,
		status
	)
end

local function initializePlayer(player: Player)
	local defaults: { [string]: any } = { Engineers = 0, ResearchPoints = 0, ResearchProject = "" }
	for attribute, default in defaults do
		if player:GetAttribute(attribute) == nil then
			player:SetAttribute(attribute, default)
		end
	end
end

function ResearchService:Initialize(machines: any, playerStateService: any)
	machineService = machines
	playerState = playerStateService

	Players.PlayerAdded:Connect(initializePlayer)
	for _, player in Players:GetPlayers() do
		initializePlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		offices[player] = nil
		wageTimers[player] = nil
	end)

	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local startRemote = remotes:FindFirstChild("StartResearch")
	if startRemote then
		startRemote:Destroy()
	end
	local remote = Instance.new("RemoteEvent")
	remote.Name = "StartResearch"
	remote.Parent = remotes
	remote.OnServerEvent:Connect(startResearch)

	machineService:RegisterKindHandler("Office", {
		onPlaced = function(record: any)
			local owner: Player? = record.owner
			local body = record.model.PrimaryPart
			if owner == nil or body == nil then
				return
			end
			offices[owner] = record
			-- E opens the research panel on the owner's screen (Research.client listens for it).
			local research = Instance.new("ProximityPrompt")
			research.Name = "ResearchPrompt"
			research.ActionText = "Research"
			research.ObjectText = "Cooperative office"
			research.KeyboardKeyCode = Enum.KeyCode.E
			research.MaxActivationDistance = 16
			research.RequiresLineOfSight = false
			research.UIOffset = Vector2.new(0, 40)
			research.Parent = body
			local hirePrompt = Instance.new("ProximityPrompt")
			hirePrompt.Name = "HirePrompt"
			hirePrompt.ActionText = "Hire engineer"
			hirePrompt.ObjectText = "Cooperative office"
			hirePrompt.KeyboardKeyCode = Enum.KeyCode.T
			hirePrompt.HoldDuration = 0.5
			hirePrompt.MaxActivationDistance = 16
			hirePrompt.RequiresLineOfSight = false
			hirePrompt.UIOffset = Vector2.new(0, -40)
			hirePrompt.Parent = body
			hirePrompt.Triggered:Connect(function(player)
				if player == owner then
					hire(player)
				else
					notify(player, "This office belongs to " .. owner.DisplayName .. ".")
				end
			end)
			-- Keep the fee on the prompt current, since it follows farmer trust.
			task.spawn(function()
				while hirePrompt.Parent do
					hirePrompt.ActionText =
						string.format("Hire engineer (%d credits)", ResearchService:HireFee(owner))
					task.wait(1)
				end
			end)
		end,
		onRemoved = function(record: any)
			local owner: Player? = record.owner
			if owner and offices[owner] == record then
				offices[owner] = nil
				if readNumber(owner, "Engineers") > 0 then
					owner:SetAttribute("Engineers", 0)
					notify(owner, "The office is gone, so your engineers have left.")
				end
			end
		end,
		describe = describe,
	})

	local accumulated = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulated += dt
		if accumulated >= TICK_SECONDS then
			tick(accumulated)
			accumulated = 0
		end
	end)
end

return ResearchService
]]></ProtectedString>
						<string name="ScriptGuid">{1D13E601-93F1-42E6-8CE8-61C1D7C0ED27}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">ResearchService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f0003bc76</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXB719BB48F98848408770D41C7971184D">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict

-- Rural Thai houses for the landscape, built from parts in the same flat style as the machines:
-- a raised wooden stilt house, a single-storey concrete house with a porch, a two-storey
-- shophouse, and a small farmhouse. Every builder picks its own wall and roof colours, so a row
-- of houses never looks copied. Each takes the ground CFrame (front door facing -Z) and a Random,
-- and returns an unparented Model.

local Houses = {}

local WALLS = {
	Color3.fromRGB(238, 226, 196), -- cream
	Color3.fromRGB(196, 222, 214), -- mint
	Color3.fromRGB(206, 220, 236), -- pale blue
	Color3.fromRGB(240, 206, 178), -- peach
	Color3.fromRGB(232, 232, 222), -- white
}
local ROOFS = {
	Color3.fromRGB(150, 86, 52), -- rust tin
	Color3.fromRGB(178, 62, 46), -- red tile
	Color3.fromRGB(62, 96, 132), -- blue tin
	Color3.fromRGB(76, 120, 90), -- green tin
	Color3.fromRGB(110, 110, 112), -- grey tin
}
local TEAK = Color3.fromRGB(122, 84, 52)
local TEAK_DARK = Color3.fromRGB(88, 60, 38)
local GLASS = Color3.fromRGB(70, 92, 100)
local TRIM = Color3.fromRGB(246, 244, 236)
local CONCRETE = Color3.fromRGB(178, 174, 166)

local function pick<T>(list: { T }, rng: Random): T
	return list[rng:NextInteger(1, #list)]
end

local function part(
	model: Model,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	collide: boolean?
): BasePart
	local item = Instance.new("Part")
	item.Name = name
	item.Size = size
	item.CFrame = cframe
	item.Color = color
	item.Material = material or Enum.Material.SmoothPlastic
	item.Anchored = true
	item.CanCollide = collide ~= false
	item.CanQuery = false
	item.CanTouch = false
	item.TopSurface = Enum.SurfaceType.Smooth
	item.BottomSurface = Enum.SurfaceType.Smooth
	item.Parent = model
	return item
end

-- A gable roof: a triangular prism whose ridge runs along X, made of two wedges back to back.
-- A wedge stands tall on its +Z face and slopes down to -Z, so the second one is turned around.
local function gableRoof(
	model: Model,
	base: CFrame,
	length: number,
	width: number,
	height: number,
	color: Color3,
	material: Enum.Material
)
	for side = -1, 1, 2 do
		local wedge = Instance.new("WedgePart")
		wedge.Name = "Roof"
		wedge.Size = Vector3.new(length, height, width / 2)
		wedge.CFrame = base
			* CFrame.new(0, height / 2, side * width / 4)
			* (if side == 1 then CFrame.Angles(0, math.pi, 0) else CFrame.new())
		wedge.Color = color
		wedge.Material = material
		wedge.Anchored = true
		wedge.CanQuery = false
		wedge.CanTouch = false
		wedge.Parent = model
	end
	-- A thin ridge cap hides the seam.
	part(
		model,
		"Ridge",
		Vector3.new(length + 0.2, 0.4, 0.8),
		base * CFrame.new(0, height, 0),
		color:Lerp(Color3.new(0, 0, 0), 0.2),
		material
	)
end

-- A window with a white frame on a wall face. `face` is the wall's outer face CFrame (looking out).
local function window(model: Model, face: CFrame, width: number, height: number)
	part(
		model,
		"Frame",
		Vector3.new(width + 0.5, height + 0.5, 0.2),
		face * CFrame.new(0, 0, -0.05),
		TRIM,
		nil,
		false
	)
	part(
		model,
		"Glass",
		Vector3.new(width, height, 0.25),
		face * CFrame.new(0, 0, -0.08),
		GLASS,
		Enum.Material.Glass,
		false
	).Transparency =
		0.15
end

local function door(model: Model, face: CFrame, color: Color3)
	part(
		model,
		"Door",
		Vector3.new(3, 6.5, 0.3),
		face * CFrame.new(0, 3.25, -0.1),
		color,
		Enum.Material.WoodPlanks,
		false
	)
end

local function newModel(name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	return model
end

-- A traditional Thai house raised on stilts, with a shaded space underneath, a wooden stair, and
-- a steep gable roof. The living floor sits high to stay dry in the wet season.
function Houses.StiltHouse(ground: CFrame, rng: Random): Model
	local model = newModel("StiltHouse")
	local length, depth, raise, wallHeight = rng:NextNumber(20, 26), rng:NextNumber(15, 18), 6, 7
	local wood = TEAK:Lerp(Color3.fromRGB(160, 120, 80), rng:NextNumber(0, 0.4))
	for _, x in { -1, -1 / 3, 1 / 3, 1 } do
		for _, z in { -1, 1 } do
			part(
				model,
				"Stilt",
				Vector3.new(0.9, raise, 0.9),
				ground * CFrame.new(x * (length / 2 - 0.6), raise / 2, z * (depth / 2 - 0.6)),
				TEAK_DARK,
				Enum.Material.Wood
			)
		end
	end
	part(
		model,
		"Floor",
		Vector3.new(length + 1, 0.8, depth + 3),
		ground * CFrame.new(0, raise, -1.5),
		wood,
		Enum.Material.WoodPlanks
	)
	local walls = ground * CFrame.new(0, raise + 0.4 + wallHeight / 2, 0)
	part(
		model,
		"Walls",
		Vector3.new(length, wallHeight, depth - 2),
		walls * CFrame.new(0, 0, 1),
		wood,
		Enum.Material.WoodPlanks
	)
	local front = walls * CFrame.new(0, 0, -depth / 2 + 1)
	window(model, front * CFrame.new(-length / 4, 0.6, 0), 3.4, 2.6)
	window(model, front * CFrame.new(length / 4, 0.6, 0), 3.4, 2.6)
	door(model, front * CFrame.new(0, -wallHeight / 2, 0), TEAK_DARK)
	-- Veranda rail along the open front of the floor.
	part(
		model,
		"Rail",
		Vector3.new(length + 1, 0.3, 0.3),
		ground * CFrame.new(0, raise + 2.6, -depth / 2 - 2.6),
		TEAK_DARK,
		Enum.Material.Wood
	)
	-- Stair from the ground up to the veranda.
	for step = 1, 6 do
		part(
			model,
			"Step",
			Vector3.new(3.2, 0.4, 1.2),
			ground * CFrame.new(length / 2 - 2.5, step, -depth / 2 - 3 - (6 - step) * 1.1),
			wood,
			Enum.Material.WoodPlanks
		)
	end
	gableRoof(
		model,
		ground * CFrame.new(0, raise + 0.4 + wallHeight, 0.5),
		length + 3,
		depth + 2,
		rng:NextNumber(6, 8),
		pick(ROOFS, rng),
		Enum.Material.CorrodedMetal
	)
	return model
end

-- A single-storey concrete house painted in a pastel colour, with a tin roof and a shaded porch.
function Houses.ConcreteHouse(ground: CFrame, rng: Random): Model
	local model = newModel("ConcreteHouse")
	local length, depth, wallHeight = rng:NextNumber(18, 24), rng:NextNumber(13, 16), 8
	local wall = pick(WALLS, rng)
	part(
		model,
		"Plinth",
		Vector3.new(length + 1, 0.8, depth + 6),
		ground * CFrame.new(0, 0.4, -2.5),
		CONCRETE,
		Enum.Material.Concrete
	)
	local walls = ground * CFrame.new(0, 0.8 + wallHeight / 2, 0)
	part(model, "Walls", Vector3.new(length, wallHeight, depth), walls, wall, Enum.Material.Plaster)
	local front = walls * CFrame.new(0, 0, -depth / 2)
	window(model, front * CFrame.new(-length / 3, 0.8, 0), 3.6, 3)
	window(model, front * CFrame.new(length / 3, 0.8, 0), 3.6, 3)
	door(
		model,
		front * CFrame.new(0, -wallHeight / 2, 0),
		pick({ TEAK, Color3.fromRGB(70, 90, 110) }, rng)
	)
	-- Porch: two posts and a lean-to roof over the plinth in front of the door.
	for side = -1, 1, 2 do
		part(
			model,
			"Post",
			Vector3.new(0.6, wallHeight - 0.6, 0.6),
			ground
				* CFrame.new(
					side * (length / 2 - 1),
					0.8 + (wallHeight - 0.6) / 2,
					-depth / 2 - 4.5
				),
			TRIM,
			Enum.Material.Concrete
		)
	end
	local roofColor = pick(ROOFS, rng)
	part(
		model,
		"Porch",
		Vector3.new(length + 1, 0.3, 5.6),
		ground
			* CFrame.new(0, 0.8 + wallHeight - 0.3, -depth / 2 - 2.6)
			* CFrame.Angles(math.rad(-8), 0, 0),
		roofColor,
		Enum.Material.CorrodedMetal
	)
	gableRoof(
		model,
		ground * CFrame.new(0, 0.8 + wallHeight, 0),
		length + 2,
		depth + 2,
		rng:NextNumber(5, 6.5),
		roofColor,
		Enum.Material.CorrodedMetal
	)
	return model
end

-- A two-storey shophouse: a shop front with a rolling shutter and awning below, living space
-- with a balcony above, and a flat roof behind a parapet. They stand along the roads.
function Houses.Shophouse(ground: CFrame, rng: Random): Model
	local model = newModel("Shophouse")
	local length, depth, storey = rng:NextNumber(14, 18), rng:NextNumber(14, 17), 7.5
	local wall = pick(WALLS, rng)
	local walls = ground * CFrame.new(0, storey, 0)
	part(model, "Walls", Vector3.new(length, storey * 2, depth), walls, wall, Enum.Material.Plaster)
	local front = ground * CFrame.new(0, 0, -depth / 2)
	part(
		model,
		"Shutter",
		Vector3.new(length - 3, storey - 1.5, 0.3),
		front * CFrame.new(0, (storey - 1.5) / 2, -0.1),
		Color3.fromRGB(150, 156, 160),
		Enum.Material.DiamondPlate,
		false
	)
	part(
		model,
		"Awning",
		Vector3.new(length + 0.6, 0.3, 3.4),
		ground * CFrame.new(0, storey + 0.2, -depth / 2 - 1.6) * CFrame.Angles(math.rad(-10), 0, 0),
		pick(ROOFS, rng),
		Enum.Material.Fabric
	)
	window(model, front * CFrame.new(-length / 4, storey * 1.5, 0), 3, 3.2)
	window(model, front * CFrame.new(length / 4, storey * 1.5, 0), 3, 3.2)
	part(
		model,
		"Balcony",
		Vector3.new(length - 2, 0.4, 2.4),
		ground * CFrame.new(0, storey + 1.4, -depth / 2 - 1.2),
		CONCRETE,
		Enum.Material.Concrete
	)
	part(
		model,
		"BalconyRail",
		Vector3.new(length - 2, 1.6, 0.25),
		ground * CFrame.new(0, storey + 2.4, -depth / 2 - 2.3),
		TRIM,
		Enum.Material.Metal
	)
	part(
		model,
		"Parapet",
		Vector3.new(length + 0.4, 1.4, depth + 0.4),
		ground * CFrame.new(0, storey * 2 + 0.7, 0),
		wall:Lerp(Color3.new(1, 1, 1), 0.3),
		Enum.Material.Plaster
	)
	-- A sign board over the shutter.
	part(
		model,
		"Sign",
		Vector3.new(length * 0.6, 1.4, 0.3),
		front * CFrame.new(0, storey - 0.4, -0.25),
		pick({
			Color3.fromRGB(214, 64, 52),
			Color3.fromRGB(46, 140, 124),
			Color3.fromRGB(244, 186, 66),
		}, rng),
		nil,
		false
	)
	return model
end

-- A small farmhouse: one room under a deep, low roof that shades a wide porch, with a water jar
-- by the door.
function Houses.Farmhouse(ground: CFrame, rng: Random): Model
	local model = newModel("Farmhouse")
	local length, depth, wallHeight = rng:NextNumber(14, 18), rng:NextNumber(10, 12), 6.5
	local wood = TEAK:Lerp(Color3.fromRGB(176, 150, 120), rng:NextNumber(0.2, 0.7))
	part(
		model,
		"Floor",
		Vector3.new(length + 4, 1, depth + 5),
		ground * CFrame.new(0, 0.5, -1.5),
		wood,
		Enum.Material.WoodPlanks
	)
	local walls = ground * CFrame.new(0, 1 + wallHeight / 2, 0.8)
	part(
		model,
		"Walls",
		Vector3.new(length, wallHeight, depth - 1.6),
		walls,
		wood,
		Enum.Material.WoodPlanks
	)
	local front = walls * CFrame.new(0, 0, -(depth - 1.6) / 2)
	window(model, front * CFrame.new(-length / 4, 0.4, 0), 2.8, 2.2)
	door(model, front * CFrame.new(length / 6, -wallHeight / 2, 0), TEAK_DARK)
	gableRoof(
		model,
		ground * CFrame.new(0, 1 + wallHeight, -1),
		length + 5,
		depth + 7,
		rng:NextNumber(4.5, 5.5),
		pick(ROOFS, rng),
		Enum.Material.CorrodedMetal
	)
	for side = -1, 1, 2 do
		part(
			model,
			"Post",
			Vector3.new(0.6, wallHeight, 0.6),
			ground * CFrame.new(side * (length / 2 + 1.5), 1 + wallHeight / 2, -depth / 2 - 3),
			TEAK_DARK,
			Enum.Material.Wood
		)
	end
	local jar = part(
		model,
		"WaterJar",
		Vector3.new(2.6, 2.6, 2.6),
		ground * CFrame.new(-length / 2 - 0.5, 2.3, -depth / 2 - 2),
		Color3.fromRGB(122, 74, 44),
		Enum.Material.Slate
	) :: Part
	jar.Shape = Enum.PartType.Ball
	return model
end

-- A rural Thai school campus (about 80 x 44 studs, gate on the -Z side): a two-storey classroom
-- block with an open corridor, a single-storey block, an open-sided canteen, a flagpole with the
-- Thai flag, a sports court, and a low fence with a gate and a sign.
function Houses.SchoolCampus(ground: CFrame, _rng: Random): Model
	local model = newModel("SchoolCampus")
	local cream = Color3.fromRGB(240, 224, 170)
	local red = Color3.fromRGB(178, 62, 46)
	local blue = Color3.fromRGB(36, 70, 140)

	-- Two-storey classroom block along the back.
	local blockA = ground * CFrame.new(-16, 0, 13)
	part(
		model,
		"BlockA",
		Vector3.new(38, 13, 12),
		blockA * CFrame.new(0, 6.5, 0),
		cream,
		Enum.Material.Plaster
	)
	part(
		model,
		"Corridor",
		Vector3.new(38, 0.6, 4),
		blockA * CFrame.new(0, 6.6, -8),
		CONCRETE,
		Enum.Material.Concrete
	)
	part(
		model,
		"Rail",
		Vector3.new(38, 1.6, 0.3),
		blockA * CFrame.new(0, 7.7, -9.9),
		TRIM,
		Enum.Material.Metal
	)
	for column = -2, 2 do
		part(
			model,
			"Pillar",
			Vector3.new(0.8, 13, 0.8),
			blockA * CFrame.new(column * 9, 6.5, -9.6),
			TRIM,
			Enum.Material.Concrete
		)
	end
	for floor = 0, 1 do
		for column = -3, 3 do
			window(model, blockA * CFrame.new(column * 5, 3.4 + floor * 6.5, -6), 2.6, 2.4)
		end
	end
	gableRoof(model, blockA * CFrame.new(0, 13, -1.5), 41, 17, 5, red, Enum.Material.Slate)

	-- Single-storey block on the right.
	local blockB = ground * CFrame.new(24, 0, 13)
	part(
		model,
		"BlockB",
		Vector3.new(26, 7.5, 12),
		blockB * CFrame.new(0, 3.75, 0),
		cream,
		Enum.Material.Plaster
	)
	for column = -2, 2 do
		window(model, blockB * CFrame.new(column * 5, 3.6, -6), 2.6, 2.4)
	end
	gableRoof(model, blockB * CFrame.new(0, 7.5, 0), 28, 14, 4, red, Enum.Material.Slate)

	-- Open-sided canteen pavilion.
	local canteen = ground * CFrame.new(26, 0, -8)
	for _, corner in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		part(
			model,
			"CanteenPost",
			Vector3.new(0.7, 6, 0.7),
			canteen * CFrame.new(corner[1] * 8, 3, corner[2] * 5),
			TRIM,
			Enum.Material.Concrete
		)
	end
	part(
		model,
		"CanteenFloor",
		Vector3.new(18, 0.4, 12),
		canteen * CFrame.new(0, 0.2, 0),
		CONCRETE,
		Enum.Material.Concrete
	)
	for row = -1, 1, 2 do
		part(
			model,
			"Table",
			Vector3.new(10, 0.4, 2.2),
			canteen * CFrame.new(0, 2.4, row * 2.5),
			Color3.fromRGB(46, 140, 124),
			nil
		)
	end
	gableRoof(
		model,
		canteen * CFrame.new(0, 6, 0),
		20,
		14,
		3,
		Color3.fromRGB(62, 96, 132),
		Enum.Material.CorrodedMetal
	)

	-- Flagpole with the Thai flag: red, white, blue (double width), white, red.
	local pole = ground * CFrame.new(-2, 0, -6)
	part(
		model,
		"FlagBase",
		Vector3.new(3, 0.8, 3),
		pole * CFrame.new(0, 0.4, 0),
		CONCRETE,
		Enum.Material.Concrete
	)
	part(
		model,
		"FlagPole",
		Vector3.new(0.35, 18, 0.35),
		pole * CFrame.new(0, 9, 0),
		TRIM,
		Enum.Material.Metal
	)
	local stripes = { red, TRIM, blue, blue, TRIM, red }
	for index, color in stripes do
		part(
			model,
			"Flag",
			Vector3.new(0.1, 0.55, 5),
			pole * CFrame.new(0, 17.6 - index * 0.55, 2.6),
			color,
			Enum.Material.Fabric,
			false
		)
	end

	-- Sports court.
	local court = ground * CFrame.new(-22, 0, -8)
	part(
		model,
		"Court",
		Vector3.new(30, 0.2, 16),
		court * CFrame.new(0, 0.1, 0),
		Color3.fromRGB(176, 96, 66),
		Enum.Material.Concrete,
		false
	)
	part(
		model,
		"CourtLine",
		Vector3.new(0.3, 0.22, 16),
		court * CFrame.new(0, 0.12, 0),
		TRIM,
		nil,
		false
	)
	for side = -1, 1, 2 do
		part(
			model,
			"Goal",
			Vector3.new(0.4, 4, 5),
			court * CFrame.new(side * 14.5, 2, 0),
			TRIM,
			Enum.Material.Metal
		)
	end

	-- Low fence with a gate on the -Z side.
	local fence = Color3.fromRGB(214, 206, 190)
	part(
		model,
		"FenceBack",
		Vector3.new(80, 2.4, 0.6),
		ground * CFrame.new(0, 1.2, 21.7),
		fence,
		Enum.Material.Concrete
	)
	for side = -1, 1, 2 do
		part(
			model,
			"FenceSide",
			Vector3.new(0.6, 2.4, 44),
			ground * CFrame.new(side * 39.7, 1.2, 0),
			fence,
			Enum.Material.Concrete
		)
		part(
			model,
			"FenceFront",
			Vector3.new(34, 2.4, 0.6),
			ground * CFrame.new(side * 23, 1.2, -21.7),
			fence,
			Enum.Material.Concrete
		)
		part(
			model,
			"GatePost",
			Vector3.new(1.4, 5, 1.4),
			ground * CFrame.new(side * 6, 2.5, -21.7),
			blue,
			Enum.Material.Concrete
		)
	end
	part(
		model,
		"GateSign",
		Vector3.new(13.4, 2, 0.5),
		ground * CFrame.new(0, 5.2, -21.7),
		blue,
		nil
	)
	-- Shown only on smog days (VillageService): the gate shut and a closure notice.
	local gate = part(
		model,
		"ClosedGate",
		Vector3.new(10.6, 3.6, 0.3),
		ground * CFrame.new(0, 1.8, -21.7),
		Color3.fromRGB(90, 96, 104),
		Enum.Material.DiamondPlate,
		false
	)
	gate.Transparency = 1
	local sign = part(
		model,
		"ClosedSign",
		Vector3.new(9, 3, 0.3),
		ground * CFrame.new(0, 8.2, -22),
		Color3.fromRGB(200, 52, 40),
		nil,
		false
	)
	sign.Transparency = 1
	local surface = Instance.new("SurfaceGui")
	surface.Name = "Notice"
	surface.Face = Enum.NormalId.Front
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 40
	surface.Enabled = false
	surface.Parent = sign
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Text = "CLOSED\nSMOG DAY"
	text.TextScaled = true
	text.FontFace =
		Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.ExtraBold)
	text.TextColor3 = Color3.new(1, 1, 1)
	text.Parent = surface
	return model
end

-- How much ground each house needs, for keeping clear of other scenery.
Houses.Radius = 16

-- Any house, chosen at random. Shophouses only make sense on a road, so callers ask for them.
function Houses.Random(ground: CFrame, rng: Random, roadside: boolean?): Model
	local roll = rng:NextNumber()
	if roadside and roll < 0.4 then
		return Houses.Shophouse(ground, rng)
	elseif roll < 0.55 then
		return Houses.StiltHouse(ground, rng)
	elseif roll < 0.85 then
		return Houses.ConcreteHouse(ground, rng)
	end
	return Houses.Farmhouse(ground, rng)
end

return Houses
]]></ProtectedString>
