	DR_StackCap = "TealDark",
	DR_WetBundle = "WetStraw",
	-- Shredder
	SH_Base = "Concrete",
	SH_BeltGuard = "SafetyYellow",
	SH_Body = "TealPaint",
	SH_BodyStripe = "SafetyYellow",
	SH_ControlPanel = "Steel",
	SH_ControlScreen = "Screen",
	SH_Discharge = "TealDark",
	SH_DryBundle1 = "Straw",
	SH_DryBundle2 = "Straw",
	SH_DustDuct = "SteelLight",
	SH_EdgeE = "SafetyYellow",
	SH_EdgeN = "SafetyYellow",
	SH_EdgeS = "SafetyYellow",
	SH_EdgeW = "SafetyYellow",
	SH_FilterBag1 = "FilterFabric",
	SH_FilterBag2 = "FilterFabric",
	SH_FilterBag3 = "FilterFabric",
	SH_FilterCap1 = "TealDark",
	SH_FilterCap2 = "TealDark",
	SH_FilterCap3 = "TealDark",
	SH_FilterFrame = "Steel",
	SH_FilterLeg1 = "Steel",
	SH_FilterLeg2 = "Steel",
	SH_Flywheel = "Steel",
	SH_FlywheelHub = "SteelLight",
	SH_InfeedBelt = "Rubber",
	SH_InfeedPost1 = "Steel",
	SH_InfeedPost2 = "Steel",
	SH_InfeedPost3 = "Steel",
	SH_InfeedPost4 = "Steel",
	SH_InfeedRailL = "TealPaint",
	SH_InfeedRailR = "TealPaint",
	SH_Motor = "TealDark",
	SH_MotorPlinth = "Steel",
	SH_OutBelt = "Rubber",
	SH_OutRailL = "TealPaint",
	SH_OutRailR = "TealPaint",
	SH_Plinth = "Steel",
	SH_PortIn = "SafetyYellow",
	SH_PortOut = "SafetyYellow",
	SH_RotorHousing = "TealPaint",
	SH_ShreddedPile = "ShreddedStraw",
	SH_Throat = "SafetyYellow",
	SH_ThroatStraw = "Straw",
}

local MachineArtPalette = {}

function MachineArtPalette.Apply(model: Instance): number
	local painted = 0
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local swatch = Swatches[PartSwatch[descendant.Name] or ""]
			if swatch then
				descendant.Color = swatch.Color
				descendant.Material = swatch.Material
				if swatch.Transparency then
					descendant.Transparency = swatch.Transparency
				end
				painted += 1
			end
		end
	end
	return painted
end

return MachineArtPalette
]]></ProtectedString>
