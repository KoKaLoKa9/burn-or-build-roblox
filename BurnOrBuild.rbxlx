					<ProtectedString name="Source"><![CDATA[--!strict

-- Transport the player lays between machine ports. Conveyors carry solid bundles and crates
-- today, laid tile by tile. Fluid and gas pipes are reserved for the energy layer (water, liquid fuel, steam,
-- biogas) and are refused until a machine with those ports exists. Plain data for Lune tests.

return {
	Order = { "Item", "Fluid", "Gas" },
	Types = {
		Item = {
			DisplayName = "Conveyor",
			ShortName = "BELT",
			-- Credits per 4 stud tile, refunded when the tile is removed.
			Cost = 5,
			Carries = "Straw bundles and pellet crates",
			Ready = true,
			-- A glass tube, so every bundle stays visible on its way (spec 4.5).
			Color = { 170, 220, 212 },
			Material = "Glass",
			Transparency = 0.38,
		},
		Fluid = {
			DisplayName = "Fluid pipe",
			ShortName = "FLUID",
			Carries = "Water and liquid fuel, for the energy update",
			Ready = false,
			Color = { 58, 140, 214 },
			Material = "SmoothPlastic",
			Transparency = 0,
		},
		Gas = {
			DisplayName = "Gas pipe",
			ShortName = "GAS",
			Carries = "Steam and biogas, for the energy update",
			Ready = false,
			Color = { 232, 196, 74 },
			Material = "SmoothPlastic",
			Transparency = 0,
		},
	},
	Diameter = 2.2,
	StudsPerSecond = 8,
	MaxLength = 240,
}
]]></ProtectedString>
					<string name="ScriptGuid">{E9D76EBB-97F7-4A43-8444-87D62283AD53}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">PipeDefinitions</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f00005b94</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX701C82286B574436A854C881790AD11A">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict

-- Grid rules for conveyor tiles that players lay one by one. Pure Luau with plain numbers, so
-- tests/ConveyorGrid.spec.luau can run it in Lune.
--
-- Cells are 4 studs square and centred on multiples of 4. A tile points one of four directions,
-- matching machine rotation steps: 0 east (+X), 1 north (-Z), 2 west (-X), 3 south (+Z).
-- A belt runs from a machine OUT port's access cell (the cell just outside the port), tile by
-- tile in each tile's direction, and ends on an IN port's access cell pointing into that machine.

local ConveyorGrid = {}

ConveyorGrid.CellSize = 4
ConveyorGrid.Directions = {
	[0] = { x = 1, z = 0 },
	[1] = { x = 0, z = -1 },
	[2] = { x = -1, z = 0 },
	[3] = { x = 0, z = 1 },
}

export type Tile = { ix: number, iz: number, dir: number }
export type Port = { key: string, inward: number, id: any, name: string? }
export type Chain = { cells: { string }, toId: any?, toPort: string?, looped: boolean }

function ConveyorGrid.Key(ix: number, iz: number): string
	return ix .. "," .. iz
end

function ConveyorGrid.CellOf(x: number, z: number): (number, number)
	local size = ConveyorGrid.CellSize
	return math.floor(x / size + 0.5), math.floor(z / size + 0.5)
end

function ConveyorGrid.Center(ix: number, iz: number): (number, number)
	return ix * ConveyorGrid.CellSize, iz * ConveyorGrid.CellSize
end

function ConveyorGrid.Step(ix: number, iz: number, dir: number): (number, number)
	local delta = ConveyorGrid.Directions[dir % 4]
	return ix + delta.x, iz + delta.z
end

-- The direction from one cell to an adjacent cell, or nil when they are not neighbours.
function ConveyorGrid.DirectionBetween(
	fromX: number,
	fromZ: number,
	toX: number,
	toZ: number
): number?
	for dir = 0, 3 do
		local delta = ConveyorGrid.Directions[dir]
		if fromX + delta.x == toX and fromZ + delta.z == toZ then
			return dir
		end
	end
	return nil
end

-- The closest of the four directions to a flat world vector.
function ConveyorGrid.DirectionOf(x: number, z: number): number
	if math.abs(x) >= math.abs(z) then
		return if x >= 0 then 0 else 2
	end
	return if z >= 0 then 3 else 1
end

-- Follows tiles from `startKey` until they reach an input pointing into its machine.
-- `inputs` maps an access cell key to the receiving port. `excludeId` skips the sending machine.
-- `toPort` is the receiving port's name, for machines with more than one input.
function ConveyorGrid.Trace(
	tiles: { [string]: Tile },
	startKey: string,
	inputs: { [string]: Port },
	excludeId: any?
): Chain
	local cells: { string } = {}
	local visited: { [string]: boolean } = {}
	local key = startKey
	local tile = tiles[key]
	while tile do
		if visited[key] then
			return { cells = cells, toId = nil, looped = true }
		end
		visited[key] = true
		table.insert(cells, key)
		local port = inputs[key]
		if port and port.id ~= excludeId and tile.dir == port.inward then
			return { cells = cells, toId = port.id, toPort = port.name, looped = false }
		end
		local nextX, nextZ = ConveyorGrid.Step(tile.ix, tile.iz, tile.dir)
		key = ConveyorGrid.Key(nextX, nextZ)
		tile = tiles[key]
	end
	return { cells = cells, toId = nil, looped = false }
end

-- Which world sides of a tile are open (belt enters or leaves there). The rest get side walls.
-- `feedSide` is the side a machine output feeds into this cell from, if any.
function ConveyorGrid.OpenSides(
	tiles: { [string]: Tile },
	tile: Tile,
	feedSide: number?
): { [number]: boolean }
	local open: { [number]: boolean } = { [tile.dir] = true }
	local hasInput = false
	for side = 0, 3 do
		local nx, nz = ConveyorGrid.Step(tile.ix, tile.iz, side)
		local neighbour = tiles[ConveyorGrid.Key(nx, nz)]
		if neighbour and (neighbour.dir + 2) % 4 == side and side ~= tile.dir then
			open[side] = true
			hasInput = true
		end
	end
	if feedSide then
		open[feedSide] = true
		hasInput = true
	end
	if not hasInput then
		-- A loose start still reads as a straight belt.
		open[(tile.dir + 2) % 4] = true
	end
	return open
end

return ConveyorGrid
]]></ProtectedString>
					<string name="ScriptGuid">{FF9BB14F-FD05-4A25-9BEF-223EDB9223A8}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">ConveyorGrid</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">3cdbb9c95d93354b0ae3817f00006501</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4C5360442A4F4911A7BE5283B42B6500">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict

-- Builds one 4 stud conveyor tile in the factory style: steel legs, a teal frame, a dark belt,
-- side walls on every closed side, and a yellow chevron showing which way the belt runs.
-- Used by the server for placed tiles and by the client for the placement ghost and hotbar icon.
-- The model's pivot is the cell centre on the floor, and +X is the belt direction before turning.

local ConveyorTile = {}

ConveyorTile.BeltTop = 1.32

local TEAL = Color3.fromRGB(46, 140, 124)
local TEAL_DARK = Color3.fromRGB(31, 92, 84)
local BELT = Color3.fromRGB(40, 42, 44)
local STEEL = Color3.fromRGB(92, 98, 104)
local YELLOW = Color3.fromRGB(244, 186, 66)

local function part(
	model: Model,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material
): Part
	local item = Instance.new("Part")
	item.Name = name
	item.Size = size
	item.CFrame = cframe
	item.Color = color
	item.Material = material
	item.Anchored = true
	item.CanCollide = false
	item.CanTouch = false
	item.CanQuery = false
	item.TopSurface = Enum.SurfaceType.Smooth
	item.BottomSurface = Enum.SurfaceType.Smooth
	item.Parent = model
	return item
end

-- `openSides` uses world sides (0 east, 1 north, 2 west, 3 south); walls go on the others.
function ConveyorTile.Build(dir: number, openSides: { [number]: boolean }): Model
	local model = Instance.new("Model")
	model.Name = "ConveyorTile"

	for _, corner in { { 1.4, 1.4 }, { 1.4, -1.4 }, { -1.4, 1.4 }, { -1.4, -1.4 } } do
		part(
			model,
			"Leg",
			Vector3.new(0.3, 0.9, 0.3),
			CFrame.new(corner[1], 0.45, corner[2]),
			STEEL,
			Enum.Material.Metal
		)
	end
	local frame = part(
		model,
		"Frame",
		Vector3.new(3.8, 0.3, 3.8),
		CFrame.new(0, 1.05, 0),
		TEAL_DARK,
		Enum.Material.SmoothPlastic
	)
	-- The frame is what clicks and raycasts hit when removing a tile.
	frame.CanQuery = true
	part(
		model,
		"Belt",
		Vector3.new(3.9, 0.12, 3.9),
		CFrame.new(0, 1.26, 0),
		BELT,
		Enum.Material.Rubber
	)

	-- Walls in local space: side 0 is the front (+X), 1 is -Z, 2 the back (-X), 3 is +Z.
	for localSide = 0, 3 do
		local worldSide = (localSide + dir) % 4
		if not openSides[worldSide] then
			local angle = localSide * math.pi / 2
			local offset = Vector3.new(math.cos(angle), 0, -math.sin(angle)) * 1.85
			local size = if localSide % 2 == 0
				then Vector3.new(0.3, 0.7, 4)
				else Vector3.new(4, 0.7, 0.3)
			part(
				model,
				"Wall",
				size,
				CFrame.new(offset.X, 1.55, offset.Z),
				TEAL,
				Enum.Material.SmoothPlastic
			)
		end
	end

	-- A chevron pointing along +X.
	for _, side in { 1, -1 } do
		part(
			model,
			"Chevron",
			Vector3.new(1.1, 0.05, 0.22),
			CFrame.new(0.05, ConveyorTile.BeltTop + 0.02, side * 0.36)
				* CFrame.Angles(0, side * math.rad(40), 0),
			YELLOW,
			Enum.Material.SmoothPlastic
		)
	end

	-- Turn every part so +X becomes the belt direction.
	local turn = CFrame.Angles(0, dir * math.pi / 2, 0)
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") then
			child.CFrame = turn * child.CFrame
		end
	end
	model.PrimaryPart = frame
	-- The pivot is the cell centre on the floor with no turn, so PivotTo only moves the tile and
	-- never resets its direction.
	frame.PivotOffset = frame.CFrame:Inverse()
	return model
end

return ConveyorTile
]]></ProtectedString>
					<string name="ScriptGuid">{ABDC5CED-D0AC-4A21-AE8F-70DBB957E97D}</string>
