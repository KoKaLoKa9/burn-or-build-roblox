					<ProtectedString name="Source"><![CDATA[--!strict

-- Generated from art/blender/*.blend. Roblox does not keep plain Blender material colors on import,
-- so imported machine meshes get their color and Roblox material from here by part name.
-- Command bar use in Studio: require(game.ReplicatedStorage.Shared.MachineArtPalette).Apply(model)

local Swatches: { [string]: { Color: Color3, Material: Enum.Material } } = {
	Concrete = { Color = Color3.fromRGB(178, 176, 163), Material = Enum.Material.Concrete },
	TealPaint = { Color = Color3.fromRGB(46, 140, 124), Material = Enum.Material.SmoothPlastic },
	TealDark = { Color = Color3.fromRGB(31, 92, 84), Material = Enum.Material.SmoothPlastic },
	SafetyYellow = { Color = Color3.fromRGB(244, 186, 66), Material = Enum.Material.SmoothPlastic },
	Steel = { Color = Color3.fromRGB(92, 98, 104), Material = Enum.Material.Metal },
	SteelLight = { Color = Color3.fromRGB(160, 166, 170), Material = Enum.Material.Metal },
	Rubber = { Color = Color3.fromRGB(40, 42, 44), Material = Enum.Material.Rubber },
	Straw = { Color = Color3.fromRGB(226, 185, 83), Material = Enum.Material.Fabric },
	WetStraw = { Color = Color3.fromRGB(163, 123, 48), Material = Enum.Material.Fabric },
	ShreddedStraw = { Color = Color3.fromRGB(188, 132, 45), Material = Enum.Material.Fabric },
	CrateWood = { Color = Color3.fromRGB(139, 98, 52), Material = Enum.Material.WoodPlanks },
	Pellets = { Color = Color3.fromRGB(112, 77, 36), Material = Enum.Material.Pebble },
	FilterFabric = { Color = Color3.fromRGB(225, 222, 210), Material = Enum.Material.Fabric },
	Screen = { Color = Color3.fromRGB(88, 214, 141), Material = Enum.Material.Neon },
	FireGlow = { Color = Color3.fromRGB(255, 122, 40), Material = Enum.Material.Neon },
}

local PartSwatch: { [string]: string } = {
	-- CollectionPoint
	CP_Bale1 = "Straw",
	CP_Bale2 = "Straw",
	CP_Bale3 = "Straw",
	CP_BaleTie1 = "CrateWood",
	CP_BaleTie2 = "CrateWood",
	CP_BaleTie3 = "CrateWood",
	CP_Base = "Concrete",
	CP_BeamN = "Steel",
