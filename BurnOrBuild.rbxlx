	DR_FeedRailL = "TealPaint",
	DR_FeedRailR = "TealPaint",
	DR_GearGuard = "SafetyYellow",
	DR_GearRing = "SafetyYellow",
	DR_HotAirDuct = "SteelLight",
	DR_Motor = "TealDark",
	DR_MotorPlinth = "Steel",
	DR_OutChute = "TealDark",
	DR_PortIn = "SafetyYellow",
	DR_PortOut = "SafetyYellow",
